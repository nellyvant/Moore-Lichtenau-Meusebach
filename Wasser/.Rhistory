library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)
library(tidyr)
chemie <- read_excel("3 Auswertung Photometrie.xlsx")
summary(chemie)
chemie1 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 1)
chemie2 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 2)
chemie3 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 3)
View(chemie1)
chemie1 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 5)
chemie2 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 6)
chemie3 <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 7)
View(chemie1)
chemie <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 5)
View(chemie)
summary(chemie)
str(chemie)
class(chemie$Datum)
# Datum als Date konvertieren
chemie$Datum <- as.Date(chemie$Datum)
str(chemie)
class(chemie$Datum)
chemie_mittel <- chemie %>%
group_by(ID) %>%
summarise(
Ammonium = mean(Ammonium, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Nitrat = mean(Nitrat, na.rm = TRUE)
)
chemie_mittel
summary(chemie)
str(chemie)
# Spalten von chr in num umwandeln
chemie <- chemie %>%
mutate(
Ammonium = as.numeric(Ammonium),
Phosphat = as.numeric(Phosphat),
Nitrat = as.numeric(Nitrat)
)
str(chemie)
chemie_mittel <- chemie %>%
group_by(ID) %>%
summarise(
Ammonium = mean(Ammonium, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Nitrat = mean(Nitrat, na.rm = TRUE)
)
chemie_mittel
# Mittelwerte je Fläche
chemie %>%
group_by(Standort) %>%
summarise(
Nitrat = mean(Nitrat, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Ammonium = mean(Ammonium, na.rm = TRUE)
)
# Mittelwerte je Fläche
chemie %>%
group_by(Standort) %>%
summarise(
Ammonium = mean(Ammonium, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Nitrat = mean(Nitrat, na.rm = TRUE)
)
ggplot(chemie, aes(x = Datum, y = Nitrat, color = ID, group = ID)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "Nitrat-Verlauf je Logger",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
chemie_standort <- chemie %>%
group_by(Datum, Standort) %>%
summarise(
Nitrat = mean(Nitrat, na.rm = TRUE),
.groups = "drop"
)
ggplot(chemie_standort,
aes(x = Datum, y = Nitrat,
color = Standort,
group = Standort)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
labs(
title = "Mittlerer Nitrat-Verlauf je Standort",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
library(tidyr)
chemie_lang <- chemie %>%
pivot_longer(
cols = c(Nitrat, Phosphat, Ammonium),
names_to = "Parameter",
values_to = "Wert"
)
ggplot(chemie_lang,
aes(Datum, Wert,
color = ID,
group = ID)) +
geom_line() +
geom_point() +
facet_wrap(~Parameter, scales = "free_y") +
theme_minimal()
ggplot(chemie, aes(x = Datum, y = Phosphat, color = ID, group = ID)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "Nitrat-Verlauf je Logger",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
ggplot(chemie, aes(x = Datum, y = Ammonium, color = ID, group = ID)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "Nitrat-Verlauf je Logger",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
