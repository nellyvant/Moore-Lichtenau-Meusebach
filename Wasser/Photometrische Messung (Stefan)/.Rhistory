library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)
library(tidyr)
chemie <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 5)
summary(chemie)
str(chemie)
class(chemie$Datum)
# Datum als Date konvertieren
chemie$Datum <- as.Date(chemie$Datum)
str(chemie)
class(chemie$Datum)
# Spalten von chr in num umwandeln
chemie <- chemie %>%
mutate(
Ammonium = as.numeric(Ammonium),
Phosphat = as.numeric(Phosphat),
Nitrat = as.numeric(Nitrat)
)
str(chemie)
# Mittelwerte je Logger
chemie_mittel <- chemie %>%
group_by(ID) %>%
summarise(
Ammonium = mean(Ammonium, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Nitrat = mean(Nitrat, na.rm = TRUE)
)
chemie_mittel
# Mittelwerte je Fläche
chemie %>%
group_by(Standort) %>%
summarise(
Ammonium = mean(Ammonium, na.rm = TRUE),
Phosphat = mean(Phosphat, na.rm = TRUE),
Nitrat = mean(Nitrat, na.rm = TRUE)
)
ggplot(chemie, aes(x = Datum, y = Nitrat, color = ID, group = ID)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "Nitrat-Verlauf je Logger",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
chemie_standort <- chemie %>%
group_by(Datum, Standort) %>%
summarise(
Nitrat = mean(Nitrat, na.rm = TRUE),
.groups = "drop"
)
ggplot(chemie_standort,
aes(x = Datum, y = Nitrat,
color = Standort,
group = Standort)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
labs(
title = "Mittlerer Nitrat-Verlauf je Standort",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
library(readxl)
library(dplyr)
library(ggplot2)
library(tidyr)
chemie <- read_excel("3 Auswertung Photometrie.xlsx", sheet = 5)
summary(chemie)
str(chemie)
class(chemie$Datum)
# Datum als Date konvertieren
chemie$Datum <- as.Date(chemie$Datum)
str(chemie)
class(chemie$Datum)
# Spalten von chr in num umwandeln
chemie <- chemie %>%
mutate(
Ammonium = as.numeric(Ammonium),
Phosphat = as.numeric(Phosphat),
Nitrat = as.numeric(Nitrat)
)
str(chemie)
# Long-Format erzeugen
chemie_long <- chemie %>%
pivot_longer(cols = c(Ammonium, Phosphat, Nitrat),
names_to = "Parameter",
values_to = "Wert")
# Statistik je Messpunkt und Parameter
chemie_stats_messpunkt <- chemie_long %>%
group_by(ID, Parameter) %>%
summarise(
mean = mean(Wert, na.rm = TRUE),
sd = sd(Wert, na.rm = TRUE),
median = median(Wert, na.rm = TRUE),
min = min(Wert, na.rm = TRUE),
max = max(Wert, na.rm = TRUE),
range = max - min,
.groups = "drop"
)
chemie_stats_messpunkt
# Statistik je Standort und Parameter
chemie_stats_flaeche <- chemie_long %>%
group_by(Standort, Parameter) %>%
summarise(
mean = mean(Wert, na.rm = TRUE),
sd = sd(Wert, na.rm = TRUE),
median = median(Wert, na.rm = TRUE),
min = min(Wert, na.rm = TRUE),
max = max(Wert, na.rm = TRUE),
range = max - min,
.groups = "drop"
)
chemie_stats_flaeche
# Statistik je Standort und Parameter
chemie_stats_flaeche <- chemie_long %>%
filter(ID != "L4") %>%
group_by(Standort, Parameter) %>%
summarise(
mean = mean(Wert, na.rm = TRUE),
sd = sd(Wert, na.rm = TRUE),
median = median(Wert, na.rm = TRUE),
min = min(Wert, na.rm = TRUE),
max = max(Wert, na.rm = TRUE),
range = max - min,
.groups = "drop"
)
chemie_stats_flaeche
View(chemie_stats_flaeche)
View(chemie_stats_messpunkt)
View(chemie_stats_messpunkt)
View(chemie)
