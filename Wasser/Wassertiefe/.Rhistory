# Daten filtern
Ab_Anax_Aeshna <- Abundanzen_long %>%
filter(Fläche == 2) %>%
filter(Art %in% c("Anax imperator",
"Aeshna cyanea"))
begehungen <- Ab_Anax_Aeshna %>%
distinct(Datum)
# Plot
ggplot(Ab_Anax_Aeshna, aes(x = Datum, y = Abundanz, fill = Art)) +
# Balken mit sauberem Dodge
geom_col(
position = position_dodge(width = 2),
width = 2
) +
# Begehungen als Rug unten + Legende aktivieren
geom_rug(
data = begehungen,
aes(x = Datum, linetype = "Begehung"),
inherit.aes = FALSE,
sides = "b",
color = "black",
alpha = 0.7
) +
# Farben + Umbenennung der Variablen
scale_fill_manual(
values = c(
"Anax imperator" = "deepskyblue3",
"Aeshna cyanea" = "deeppink4"
),
#labels = c(
#  "Libellula quadrimaculata" = "Imago",
#  "Libellula Ex" = "Exuvie"
#)
) +
# Legende für Begehung
scale_linetype_manual(
values = c(Begehung = 1),
name = "",
guide = guide_legend(
override.aes = list(color = "black")
)
) +
# Y-Achse
scale_y_continuous(
limits = c(0, 5),
breaks = 0:5
) +
# X-Achse
scale_x_date(
date_breaks = "1 month",
date_labels = "%b %Y"
) +
labs(
x = NULL,
y = "Abundanzklasse",
fill = "Art",
title = ""
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
