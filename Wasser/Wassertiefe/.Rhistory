Ex_long <- Ex %>%
pivot_longer(
cols = c(`Libellula quadrimaculata`,
`Libellula Ex`,
`Aeshna cyanea`,
`Aeshna Ex`,
`Sympetrum danae`,
`Sympetrum Ex`),
names_to = "Variable",
values_to = "Abundanz"
)
# Daten filtern
Ex_lib <- Ex_long %>%
filter(Fläche == 2) %>%
filter(Variable %in% c("Libellula quadrimaculata",
"Libellula Ex"))
begehungen <- Ex_lib %>%
distinct(Datum)
# Plot
ggplot(Ex_lib, aes(x = Datum, y = Abundanz, fill = Variable)) +
# Balken mit sauberem Dodge
geom_col(
position = position_dodge(width = 2.5),
width = 2.4
) +
# Begehungen als Rug unten + Legende aktivieren
geom_rug(
data = begehungen,
aes(x = Datum, linetype = "Begehung"),
inherit.aes = FALSE,
sides = "b",
color = "black",
alpha = 0.7
) +
# Farben + Umbenennung der Variablen
scale_fill_manual(
values = c(
"Libellula quadrimaculata" = "blue4",
"Libellula Ex" = "cyan4"
),
labels = c(
"Libellula quadrimaculata" = "Imago",
"Libellula Ex" = "Exuvie"
)
) +
# Legende für Begehung
scale_linetype_manual(
values = c(Begehung = 1),
name = "",
guide = guide_legend(
override.aes = list(color = "black")
)
) +
# Y-Achse
scale_y_continuous(
limits = c(0, 5),
breaks = 0:5
) +
# X-Achse
scale_x_date(
date_breaks = "1 month",
date_labels = "%b %Y"
) +
labs(
x = NULL,
y = "Abundanzklasse",
fill = "Entwicklungsform",
title = ""
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(angle = 45, hjust = 1, size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
panel.grid.major = element_line(color = "grey75"),
panel.grid.minor = element_line(color = "grey85"),
axis.ticks = element_blank(),
panel.background = element_rect(fill = "white", color = NA)
)
