#height = 6,
#dpi = 300
#)
#### Jahresverlauf - Liniendiagramm
plot_lin1 <- function(df, st, titel = NULL) {
# Daten nach Standort filtern
df_sub1 <- df %>% filter(Standort == st)
ggplot(df_sub1, aes(x = Datum, y = Wassertiefe, color = factor(Messpunkt))) +
geom_line(linewidth = 1) +
#geom_point(size = 2) +
labs(
title = titel,
x = "",
y = "Mittlere Wassertiefe (cm)",
color = "Messstelle"
) +
scale_x_date(
date_breaks = "1 month",
date_labels = "%b %Y"
) +
scale_color_manual(
values = c(
"1" = "#F8766D",
"2" = "#7CAE00",
"3" = "#00BFC4",
"4" = "#C77CFF"
)
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(angle = 45, hjust = 1, size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
panel.grid.major = element_line(color = "grey75"),
panel.grid.minor = element_line(color = "grey85"),
axis.ticks = element_blank(),
panel.background = element_rect(fill = "white", color = NA)
)
}
#### Unterschiede zw. den Messstellen - Boxplot
plot_box <- function(df, st, titel=NULL, x_name=NULL) {
# Daten filtern
df_sub2 <- df %>% filter(Standort == st)
# x-Achsenname setzen, falls NULL
if (is.null(x_name)) {
x_name <- "Messpunkt"  # Standard
}
ggplot(df_sub2, aes(x = factor(Messpunkt), y = Wassertiefe, fill = factor(Messpunkt))) +
geom_boxplot() +
labs(
title = titel,
x = x_name,           # hier wird der flexible Name verwendet
y = "Wassertiefe (cm)",
fill = "Messstelle"
) +
scale_fill_manual(
values = c(
"1" = "#F8766D",
"2" = "#7CAE00",
"3" = "#00BFC4",
"4" = "#C77CFF"
)
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
panel.grid.major = element_line(color = "grey75"),
panel.grid.minor = element_line(color = "grey85"),
axis.ticks = element_blank(),
panel.background = element_rect(fill = "white", color = NA)
)
}
plot_lin1(Wassertiefen, "MT", titel="")
# Boxplot
plot_box(Wassertiefen, st="MT",
titel="",
x_name="Meusebach trocken")
# Liniendiagramm
plot_lin1(Wassertiefen, "MN", titel="")
# Boxplot
plot_box(Wassertiefen, st="MN",
titel="",
x_name="Meusebach nass")
# Liniendiagramm
plot_lin1(Wassertiefen, "L", titel="")
# Boxplot
plot_box(Wassertiefen, st="L",
titel="",
x_name="Lichtenau")
library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)
library(tidyr)
Abundanzen <- read_excel("Abundanztabelle.xlsx")
summary(Abundanzen)
str(Abundanzen)
class(Abundanzen$Datum)
Ex <- read_excel("Abundanztabelle.xlsx", sheet = 2)
summary(Ex)
str(Ex)
class(Ex$Datum)
# Datum als Date konvertieren, Fläche als Character
Abundanzen$Datum <- as.Date(Abundanzen$Datum, format = "%d.%m.%Y")
class(Abundanzen$Datum)
Abundanzen <- Abundanzen %>%
mutate(Fläche = as.character(Fläche))
class(Abundanzen$Fläche)
Ex$Datum <- as.Date(Ex$Datum, format = "%d.%m.%Y")
class(Ex$Datum)
# Long-Format erstellen
Abundanzen_long <- Abundanzen %>%
pivot_longer(
cols = where(is.numeric),
names_to = "Art",
values_to = "Abundanz"
)
begehungen <- Abundanzen %>%
distinct(Datum)
Abundanzen <- Abundanzen %>%
arrange(Datum, Fläche) %>%
group_by(Datum) %>%
mutate(
n = n(),
idx = row_number(),
dodge_width = 1,
Datum_dodge = Datum + (idx - (n + 1) / 2) * dodge_width
) %>%
ungroup()
ggplot(
Abundanzen,
aes(
x = Datum_dodge,
y = `Pyrrhosoma nymphula`,
fill = Fläche
)
) +
geom_col(
position = "identity",
width = 1
) +
geom_rug(
data = begehungen,
aes(x = Datum, linetype = "Begehung"),
inherit.aes = FALSE,
sides = "b",
color = "black",
alpha = 0.7
) +
scale_fill_manual(
values = c(
"1" = "#D55E00",
"2" = "#6495ED",
"3" = "#006400"
)
) +
scale_linetype_manual(
values = c(Begehung = 1),
name = "",
guide = guide_legend(
override.aes = list(color = "black")
)
) +
scale_y_continuous(
limits = c(0, 5),
breaks = 0:5
) +
scale_x_date(
date_breaks = "1 month",
date_labels = "%b %Y"
) +
labs(
x = NULL,
y = "Abundanzklasse",
fill = "Fläche",
title = ""
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(angle = 45, hjust = 1, size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
panel.grid.major = element_line(color = "grey75"),
panel.grid.minor = element_line(color = "grey85"),
axis.ticks = element_blank(),
panel.background = element_rect(fill = "white", color = NA)
)
