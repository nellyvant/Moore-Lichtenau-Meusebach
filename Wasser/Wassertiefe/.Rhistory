#### Jahresverlauf - Liniendiagramm (angepasst an Vorlage)
plot_lin1 <- function(df, st, titel = NULL) {
library(dplyr)
library(ggplot2)
# Daten nach Standort filtern
df_sub1 <- df %>% filter(Standort == st)
}
plot_lin1(Wassertiefen, "MT", titel="Wassertiefen in Meusebach trocken Mai–September 2025")
plot_lin1(Wassertiefen, "MT", titel="Wassertiefen in Meusebach trocken Mai–September 2025")
# Daten nach Standort filtern
df_sub1 <- df %>% filter(Standort == st)
#### Jahresverlauf - Liniendiagramm
plot_lin1 <- function(df, st, titel = NULL) {
library(dplyr)
library(ggplot2)
# Daten nach Standort filtern
df_sub1 <- df %>% filter(Standort == st)
ggplot(df_sub1, aes(x = Datum, y = Wassertiefe, color = factor(Messpunkt))) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
labs(
title = titel,
x = "",
y = "Mittlere Wassertiefe (cm)",
color = "Fläche"
) +
scale_color_manual(
breaks = c("MT", "MN", "L"),
values = c(
"MT" = "#D55E00",
"MN" = "#6495ED",
"L"  = "#006400"
),
labels = c(
"MT" = "1",
"MN" = "2",
"L"  = "3"
)
) +
scale_x_date(
date_breaks = "1 month",
date_labels = "%b %Y"
) +
theme(
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(angle = 45, hjust = 1, size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
panel.grid.major = element_line(color = "grey75"),
panel.grid.minor = element_line(color = "grey85"),
axis.ticks = element_blank(),
panel.background = element_rect(fill = "white", color = NA)
)
}
