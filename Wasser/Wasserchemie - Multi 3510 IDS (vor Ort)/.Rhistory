# Datum als Date konvertieren
WS$Datum <- as.Date(WS$Datum)
str(WS)
class(WS$Datum)
# Spalten von chr in num umwandeln
WS <- WS %>%
mutate(
Messstelle = as.numeric(Messstelle),
Messwert = as.numeric(Messwert),
Temperatur = as.numeric(Temperatur)
)
str(WS)
# Statistiken je Messpunkt und Parameter
WS_stats_Messpunkte <- WS %>%
group_by(ID, Parameter) %>%
summarise(
Mean = mean(Messwert, na.rm = TRUE),
Median = median(Messwert, na.rm = TRUE),
SD = sd(Messwert, na.rm = TRUE),
Min = min(Messwert, na.rm = TRUE),
Max = max(Messwert, na.rm = TRUE),
Range = Max - Min,
.groups = "drop"
)
WS_stats_Messpunkte
# Statistiken je Fläche und Parameter
WS_stats_Flaeche <- WS %>%
group_by(Fläche, Parameter) %>%
summarise(
Mean = mean(Messwert, na.rm = TRUE),
Median = median(Messwert, na.rm = TRUE),
SD = sd(Messwert, na.rm = TRUE),
Min = min(Messwert, na.rm = TRUE),
Max = max(Messwert, na.rm = TRUE),
Range = Max - Min,
.groups = "drop"
)
WS_stats_Flaeche
# Mittelwerte je Messpunkt
# Tagesmittelwerte
tagesstats_temp_id <- WS %>%
group_by(Datum, ID) %>%
summarise(
Mean   = mean(Temperatur, na.rm = TRUE),
Median = median(Temperatur, na.rm = TRUE),
SD     = sd(Temperatur, na.rm = TRUE),
Min    = min(Temperatur, na.rm = TRUE),
Max    = max(Temperatur, na.rm = TRUE),
Range  = max(Temperatur, na.rm = TRUE) - min(Temperatur, na.rm = TRUE),
.groups = "drop"
)
# Mittelwert über den gesamten Untersuchungszeitraum
gesamtstats_temp_id <- WS %>%
group_by(ID) %>%
summarise(
Mean   = mean(Temperatur, na.rm = TRUE),
Median = median(Temperatur, na.rm = TRUE),
SD     = sd(Temperatur, na.rm = TRUE),
Min    = min(Temperatur, na.rm = TRUE),
Max    = max(Temperatur, na.rm = TRUE),
Range  = max(Temperatur, na.rm = TRUE) - min(Temperatur, na.rm = TRUE),
.groups = "drop"
)
# Mittelwerte je Fläche
# Tagesmittelwerte
tagesstats_temp_flaeche <- WS %>%
group_by(Datum, Fläche) %>%
summarise(
Mean   = mean(Temperatur, na.rm = TRUE),
Median = median(Temperatur, na.rm = TRUE),
SD     = sd(Temperatur, na.rm = TRUE),
Min    = min(Temperatur, na.rm = TRUE),
Max    = max(Temperatur, na.rm = TRUE),
Range  = max(Temperatur, na.rm = TRUE) - min(Temperatur, na.rm = TRUE),
.groups = "drop"
)
# Mittelwert über den gesamten Untersuchungszeitraum
gesamtstats_temp_flaeche <- WS %>%
group_by(Fläche) %>%
summarise(
Mean   = mean(Temperatur, na.rm = TRUE),
Median = median(Temperatur, na.rm = TRUE),
SD     = sd(Temperatur, na.rm = TRUE),
Min    = min(Temperatur, na.rm = TRUE),
Max    = max(Temperatur, na.rm = TRUE),
Range  = max(Temperatur, na.rm = TRUE) - min(Temperatur, na.rm = TRUE),
.groups = "drop"
)
# Statistiken je Fläche und Parameter
WS_stats_Flaeche_L <- WS %>%
filter(ID != "L4") %>%
group_by(Fläche, Parameter) %>%
summarise(
Mean = mean(Messwert, na.rm = TRUE),
Median = median(Messwert, na.rm = TRUE),
SD = sd(Messwert, na.rm = TRUE),
Min = min(Messwert, na.rm = TRUE),
Max = max(Messwert, na.rm = TRUE),
Range = Max - Min,
.groups = "drop"
)
WS_stats_Flaeche_L
View(gesamtstats_temp_flaeche)
View(gesamtstats_temp_id)
View(tagesstats_temp_flaeche)
View(tagesstats_temp_id)
View(WS_stats_Flaeche)
View(WS_stats_Flaeche_L)
View(WS_stats_Flaeche)
