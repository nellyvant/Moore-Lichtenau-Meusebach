group = Standort)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
labs(
title = "Mittlerer Nitrat-Verlauf je Standort",
x = "Datum",
y = "Nitrat [mg/L]"
) +
theme_minimal()
