# Arten
# --------------------------------------------------
geom_point(
data = species_df,
aes(x = DCA2, y = DCA3),
shape = 17,
size = 2.5,
colour = "grey30"
) +
geom_text_repel(
data = species_df,
aes(
x = DCA2,
y = DCA3,
label = Art
),
