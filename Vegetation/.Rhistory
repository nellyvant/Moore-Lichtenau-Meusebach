library(tidyverse)
library(readxl)
library(writexl)
library(vegan)
library(ggplot2)
library(ggrepel)
library(corrplot)
library(lme4)
library(performance)
library(MASS)
library(ggnewscale)
library(grid)
library(conflicted)
conflict_prefer("select", "dplyr")
conflict_prefer("filter", "dplyr")
library(mgcv)
library(emmeans)
comm <- veg_long %>%
filter(site=="Meu_trock") %>%
group_by(plot.ID, Art) %>%
summarise(
Deckung = sum(Deckung, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
)%>%
tibble::column_to_rownames("plot.ID")
#entferne leere zeilen &spalten weil decorana damit nciht rechnen kann
comm <- comm[
rowSums(comm) > 0,
colSums(comm) > 0,
drop = FALSE
]
dca <- decorana(comm)
summary(dca)
env <- merged_data %>%
filter(site == "Meu_trock")
fit <- envfit(dca, env[, c("Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Hoehe"
#,
# "TL",
#  "ML",
#  "HL",
#  "SL"
)])
fit
comm <- veg_long %>%
filter(site=="Meu_trock"&Schicht =="ML") %>%
group_by(plot.ID, Art) %>%
summarise(
Deckung = sum(Deckung, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
)%>%
tibble::column_to_rownames("plot.ID")
#entferne leere zeilen &spalten weil decorana damit nciht rechnen kann
comm <- comm[
rowSums(comm) > 0,
colSums(comm) > 0,
drop = FALSE
]
dca <- decorana(comm)
summary(dca)
env_vars <- c(
"Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Hoehe"
#  ,
#  "TL",
#  "ML",
#  "HL",
#  "SL"
)
env <- merged_data %>%
filter(
site == "Meu_trock",
as.character(Plot) %in% rownames(comm)
) %>%
select(
plot.ID = Plot,
dplyr::all_of(env_vars)
) %>%
mutate(plot.ID = as.character(plot.ID)) %>%
distinct()
fit <- envfit(dca, env[, env_vars])
fit
