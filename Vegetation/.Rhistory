group_by(Art) %>%
summarise(Mittelwert_Deckung = mean(Deckung, na.rm = TRUE)) %>%
arrange(desc(Mittelwert_Deckung)) %>%
slice_head(n = 10) %>%
mutate(Art = factor(Art, levels = rev(Art)))  # Sortierung pro Fläche
# Plot mit mehr Platz zwischen den Balken
p <- ggplot(data_flaeche, aes(x = Art, y = Mittelwert_Deckung)) +
geom_col(fill = farben[i], width = 0.4) +  # Balkenbreite reduzieren
coord_flip() +
labs(title = paste("Häufigste Arten in", flaeche),
x = "Art",
y = "Mittlere Deckung [%]") +
theme_minimal() +
theme(
legend.position = "none",
axis.text.y = element_text(size = 7, hjust = 0)
) +
scale_x_discrete(expand = expansion(add = -2)) +  # Abstand zwischen Arten erhöhen
ylim(0, global_max)
plot_list[[i]] <- p
}
