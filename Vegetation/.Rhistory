p2$data
p2 <- MN_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, n), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Auf der Pfalz"
) +
theme_minimal()
p2$data
comm_MN <- veg_long %>%
filter(site=="Meu_nass") %>%
group_by(plot.ID, Art) %>%
summarise(
Deckung = sum(Deckung, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
)%>%
tibble::column_to_rownames("plot.ID")
#entferne leere zeilen &spalten weil decorana damit nciht rechnen kann
comm_MN <- comm_MN[
rowSums(comm_MN) > 0,
colSums(comm_MN) > 0,
drop = FALSE
]
dca <- decorana(comm_MN)
summary(dca)
env_MN <- merged_data %>%
filter(site == "Meu_nass")
fit <- envfit(dca, env_MN[, c("Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Hoehe",
"TL",
"ML",
"HL",
"SL")])
comm_MN <- veg_long %>%
filter(site=="Meu_nass") %>%
group_by(plot.ID, Art) %>%
summarise(
Deckung = sum(Deckung, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
)%>%
tibble::column_to_rownames("plot.ID")
#entferne leere zeilen &spalten weil decorana damit nciht rechnen kann
comm_MN <- comm_MN[
rowSums(comm_MN) > 0,
colSums(comm_MN) > 0,
drop = FALSE
]
dca <- decorana(comm_MN)
summary(dca)
env_MN <- merged_data %>%
filter(site == "Meu_nass")
fit <- envfit(dca, env_MN[, c("Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Richness",
"Shannon",
"Evenness",
"Hoehe",
"TL",
"SL",
"HL",
"ML",
"bare.soil",
"Sukzessionszeiger",
"Moorart",
"woody")],
na.rm=T)
fit
plot(dca)
arrows <- as.data.frame(scores(fit, display = "vectors"))
arrows$Variable <- rownames(arrows)
arrows$p_value <- fit$vectors$pvals
arrows$r2 <- fit$vectors$r
arrows$Variable <- c(
"Licht",
"Temperatur",
"Feuchte",
"Stickstoff",
"Basengehalt",
"Richness",
"Shannon-Diversität",
"Evenness",
"Höhe",
"Baumschicht",
"Strauchschicht",
"Krautschicht",
"Moosschicht",
"bare soil",
"Sukzessionszeiger",
"Moorzeiger",
"Gehölze"
)
# nur Umweltvariablen mit signifikanten p-Werten anzeigen
arrows_sig <- arrows %>%
filter(p_value <= 0.05)
dca_scores <- scores(dca, display = "sites")
dca_df <- as.data.frame(dca_scores)
dca_df$Name <- rownames(dca_df)
dca_df$site <- vegdata$site[match(dca_df$Name, vegdata$plot.ID)]
dca_df$Transektnummer <- vegdata$Transektnummer[match(dca_df$Name, vegdata$plot.ID)]
dca_df$Distanz <- abs(dca_df$Transektnummer)
ggplot(dca_df, aes(DCA1, DCA2, colour = Distanz)) +
geom_point(size = 3) +
scale_colour_gradient2(
low = "#005A8D",
mid = "#FFD700",
high = "#7A0177",
midpoint = 0,
name = "Entfernung zum Mittelpunkt")+
geom_segment(
data = arrows_sig,
aes(
x = 0, y = 0,
xend = DCA1 * 2,
yend = DCA2 * 2
),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.25, "cm")),
colour = "black") +
geom_text(
data = arrows_sig,
aes(
x = DCA1 * 2.3,
y = DCA2 * 2.3,
label = Variable
),
inherit.aes = FALSE
) +
labs(
title = "DCA Vegetation Auf der Pfalz",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
summary(dca)
fit
fit %>%
reorder(desc(DCA1))
desc(fit$DCA1)
fit$vectors
ggplot(dca_df, aes(DCA1, DCA2, colour = Distanz)) +
geom_point(size = 3) +
scale_colour_gradient2(
low = "#005A8D",
mid = "#FFD700",
high = "#7A0177",
midpoint = 0,
name = "Entfernung zum Mittelpunkt")+
geom_segment(
data = arrows_sig,
aes(
x = 0, y = 0,
xend = DCA1 * 2,
yend = DCA2 * 2
),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.25, "cm")),
colour = "black") +
geom_text(
data = arrows_sig,
aes(
x = DCA1 * 2.3,
y = DCA2 * 2.3,
label = Variable
),
inherit.aes = FALSE
) +
labs(
title = "DCA Vegetation Auf der Pfalz",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
ggplot(dca_df, aes(DCA1, DCA2, colour = Transektnummer)) +
geom_point(size = 3) +
geom_point(
data = species_df,
aes(x = DCA1, y = DCA2),
inherit.aes = FALSE,
shape = 17,
size = 3,
colour = "grey20"
) +
geom_text_repel(
data = species_df,
aes(x = DCA1, y = DCA2, label = Art),
inherit.aes = FALSE,
size = 3,
colour = "grey20",
box.padding = 0.5,
point.padding = 0.3,
segment.colour = "grey60",
max.overlaps = Inf
) +
scale_colour_gradient2(
low = "#005A8D",
mid = "#FFD700",
high = "#7A0177",
midpoint = 0,
breaks = range(dca_df$Transektnummer, na.rm = TRUE),
labels = c("Westen", "Osten"),
name = "Position im Transekt"
) +
labs(
title = "DCA Vegetation Kleiner Sumpf, West-Ost Transekt",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
# einzelne site mit arten
comm_L <- veg_long %>%
filter(site=="Lic"&Transekt =="WO") %>%
group_by(plot.ID, Art) %>%
summarise(
Deckung = sum(Deckung, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
)%>%
tibble::column_to_rownames("plot.ID")
dca <- decorana(comm_L)
summary(dca)
plot(dca)
dca_scores <- scores(dca, display = "sites")
dca_df <- as.data.frame(dca_scores)
dca_df$Name <- rownames(dca_df)
dca_df$site <- vegdata$site[match(dca_df$Name, vegdata$plot.ID)]
dca_df$Transektnummer <- vegdata$Transektnummer[match(dca_df$Name, vegdata$plot.ID)]
species_df <- as.data.frame(scores(dca, display = "species", choices = c(1, 2)))
species_df$Art <- rownames(species_df)
species_totals <- colSums(comm_L, na.rm = TRUE)
species_df <- species_df %>%
filter(Art %in% names(species_totals[species_totals > 0]))
ggplot(dca_df, aes(DCA1, DCA2, colour = Transektnummer)) +
geom_point(size = 3) +
geom_point(
data = species_df,
aes(x = DCA1, y = DCA2),
inherit.aes = FALSE,
shape = 17,
size = 3,
colour = "grey20"
) +
geom_text_repel(
data = species_df,
aes(x = DCA1, y = DCA2, label = Art),
inherit.aes = FALSE,
size = 3,
colour = "grey20",
box.padding = 0.5,
point.padding = 0.3,
segment.colour = "grey60",
max.overlaps = Inf
) +
scale_colour_gradient2(
low = "#005A8D",
mid = "#FFD700",
high = "#7A0177",
midpoint = 0,
breaks = range(dca_df$Transektnummer, na.rm = TRUE),
labels = c("Westen", "Osten"),
name = "Position im Transekt"
) +
labs(
title = "DCA Vegetation Kleiner Sumpf, West-Ost Transekt",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
