mutate(
x = if_else(Transekt == "WO", Transektnummer, 0),
y = if_else(Transekt == "NS", Transektnummer, 0)
)
plot_data%>%
filter(site=="Lic")%>%
ggplot( aes(x = x, y = y, color = Weighted_wetness)) +
geom_point(size = 4) +
coord_equal() +
scale_color_viridis_c(name = "Feuchtezahl") +
labs(x = "West–Ost", y = "Süd–Nord") +
theme_minimal()
plot_data %>%
filter(site == "Lic") %>%
ggplot(aes(x = x, y = y, color = Weighted_wetness)) +
geom_point(size = 4) +
coord_equal() +
scale_color_viridis_c(name = "Feuchtezahl") +
annotate("text",
x = max(plot_data$x),
y = 0,
label = "O",
size = 5,
hjust = 1.4) +
annotate("text",
x = min(plot_data$x),
y = 0,
label = "W",
size = 5,
hjust = 1.4) +
annotate("text",
x = 0,
y = max(plot_data$y),
label = "N",
size = 5,
vjust = -0.3) +
annotate("text",
x = 0,
y = min(plot_data$y),
label = "S",
size = 5,
vjust = 1.3) +
labs(x = NULL, y = NULL)
