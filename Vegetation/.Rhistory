library(grid)
library(conflicted)
conflict_prefer("select", "dplyr")
conflict_prefer("filter", "dplyr")
library(mgcv)
library(emmeans)
merged_data <- merged_data %>%
group_by(site) %>%
mutate(
Hoehe_rel = Hoehe - mean(Hoehe, na.rm = TRUE)
) %>%
ungroup()
View(merged_data)
