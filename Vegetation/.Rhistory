library(readxl)
library(writexl)
library(tidyverse)
library(dplyr)
library(permute)
library(vegan)
View(veg_long)
names(veglong)
names(veg_long)
comm_matrix <- veg_long %>%
select(plot.ID, site, Schicht, Art, Deckung) %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("plot.ID")
head(veg_long)
comm_matrix <- veg_long %>%
group_by(plot.ID, Art) %>%
summarise(Deckung = sum(Deckung), .groups = "drop") %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("plot.ID")
View(comm_matrix)
comm_matrix <- veg_long %>%
group_by(plot.ID, Name, Art) %>%
summarise(Deckung = sum(Deckung), .groups = "drop") %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("plot.ID")
View(vegdata)
species_richness <- specnumber(comm_matrix)
shannon_index <- diversity(comm_matrix, index = "shannon")
str(comm_matrix)
comm_matrix <- veg_long %>%
group_by(Name, Art) %>%
summarise(Deckung = sum(Deckung), .groups = "drop") %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("Name")
str(comm_matrix)
species_richness <- specnumber(comm_matrix)
shannon_index <- diversity(comm_matrix, index = "shannon")
relative_freq <- decostand(comm_matrix, method = "total")
species_evenness <- shannon_index / log(specnumber(comm_matrix))
results <- data.frame(
Plot = rownames(comm_matrix),
Richness = species_richness,
Shannon = shannon_index,
Evenness = species_evenness
)
print(results)
View(results)
View(vegdata)
getwd()
#als Excel speichern
write_xlsx(results, "Ergebnisse_species_richness.xlsx")
