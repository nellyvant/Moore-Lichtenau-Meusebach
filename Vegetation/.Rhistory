geom="polygon",
alpha = 0.2,
show.legend = F) +
geom_point(data = sites,
aes(PC1, PC2, color = Standort),
size = 3) +
geom_text(data = sites,
aes(PC1, PC2, label = Logger, color = Standort),
vjust = -1, show.legend = F) +
geom_segment(data = vars,
aes(x = 0, y = 0,
xend = PC1, yend = PC2),
arrow = arrow(length = unit(0.25, "cm")),
color = "black") +
geom_text(data = vars,
aes(PC1, PC2, label = Label),
color = "black",
vjust = -0.5, hjust= 0.3) +
xlab(paste0("PC1 (", round(eig[1]*100,1), "%)")) +
ylab(paste0("PC2 (", round(eig[2]*100,1), "%)")) +
theme_bw() +
coord_fixed(ratio = 0.7)
# Hull-Funktion für jeden Standort
hulls <- sites %>%
dplyr::group_by(Standort) %>%
dplyr::slice(chull(PC1, PC2))
vars$LabelX <- vars$PC1 * c(2.1, 1.7, 1.4)
vars$LabelY <- vars$PC2 * c(1.5, 2, 1.8)
ggplot() +
geom_polygon(data = hulls,
aes(x = PC1, y = PC2, fill = Standort),
alpha = 0.2, show.legend = F) +
geom_point(data = sites,
aes(PC1, PC2, color = Standort),
size = 3) +
geom_text(data = sites,
aes(PC1, PC2, label = Logger, color = Standort),
vjust = -1, show.legend = F) +
geom_segment(data = vars,
aes(x = 0, y = 0,
xend = PC1 * 1.5,
yend = PC2 * 1.5),
arrow = arrow(length = unit(0.25, "cm")),
color = "black") +
geom_text(data = vars,
aes(x=LabelX, y=LabelY, label = Label),
color = "black") +
xlab(paste0("PC1 (", round(eig[1]*100,1), "%)")) +
ylab(paste0("PC2 (", round(eig[2]*100,1), "%)")) +
theme_classic() +
coord_cartesian(xlim = c(-2, 2), ylim = c(-2, 2))
#theme_classic im zweiten plot, während theme_bw im ersten
#| label: boxplot of mean humidity each area
summary_daily_logger %>%
filter(Standort == "L", Logger %in% c("M", "N", "O", "S", "W"))%>%
ggplot(aes(x = Logger, y = rLF_mean, fill = Logger)) +
geom_boxplot() +
labs(
title = "Vergleich der Tagesmittelwerte pro Logger - Lichtenau",
x = "Loggerstandort",
y = "Tagesmittel Luftfeuchte (°C)"
) +
theme_minimal() +
theme(legend.position = "none")
summary_daily_logger %>%
filter(Standort == "MN", Logger %in% c("M", "N", "O", "S", "W"))%>%
ggplot(aes(x = Logger, y = rLF_mean, fill = Logger)) +
geom_boxplot() +
labs(
title = "Vergleich der Tagesmittelwerte pro Logger - Meusebach nass",
x = "Loggerstandort",
y = "Tagesmittel Luftfeuchte (°C)"
) +
theme_minimal() +
theme(legend.position = "none")
summary_daily_logger %>%
filter(Standort == "MT", Logger %in% c("M", "N", "O", "S", "W"))%>%
ggplot(aes(x = Logger, y = rLF_mean, fill = Logger)) +
geom_boxplot() +
labs(
title = "Vergleich der Tagesmittelwerte pro Logger - Meusebach trocken",
x = "Loggerstandort",
y = "Tagesmittel Luftfeuchte (°C)"
) +
theme_minimal() +
theme(legend.position = "none")
