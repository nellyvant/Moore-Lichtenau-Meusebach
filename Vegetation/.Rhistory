coord_equal() +
scale_color_manual(
name = "Sphagnum-Arten",
values = dark2_erweitert,
guide = guide_legend(
override.aes = list(
size = 5,
alpha = 1))) +
scale_size_continuous(name = "Deckung",range = c(4, 10)) +
labs(
x = "West–Ost",
y = "Süd–Nord"
) +
theme_minimal()
ggsave("L-sphag.png",p8, path="plots",width = 12, height = 10, dpi = 300)
