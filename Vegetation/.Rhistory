#| label: violinplot central logger
all_loggers %>%
filter(Logger == "M", Licht_lux > 1) %>%
ggplot(aes(x = Standort, fill = Standort, y = Licht_lux)) +
geom_boxplot(width = 0.1, outlier.colour = "red") +
geom_violin(na.rm = TRUE, alpha = 0.5) +
scale_x_discrete(labels = c("L" = "Kleiner Sumpf", "MN" = "Auf der Pfalz", "MT" = "Fuchshügel")) +
labs(title = "Lichtverteilung – mittlere Logger (nur Tag)", x = "Standort", y = "Licht (lux)") +
theme(
legend.position = "none"
)
#ggsave("light_violinplot.png", width = 6, height=4)
#Vergleich Tagessumme
summary_daily_logger %>%
ggqqplot(
x = "Licht_summe",
facet.by = c("Standort", "Logger"),
add = "qqline")
summary_daily_logger %>%
ggplot(aes(x = Licht_summe)) +
geom_histogram(bins = 10) +
facet_grid(Standort ~ Logger, scales = "free") +
theme_minimal()
#Vergleich Tagessumme
summary_daily_logger %>%
ggqqplot(
x = "Licht_summe",
facet.by = c("Standort", "Logger"),
add = "qqline")
summary_daily_logger %>%
ggplot(aes(x = Licht_summe)) +
geom_histogram(bins = 10) +
facet_grid(Standort ~ Logger, scales = "free") +
theme_minimal()
dat_L_fried <- summary_daily_logger %>%
filter(Standort == "L") %>%
arrange(Logger_ID, Datum)
friedman.test(Licht_summe ~ Logger_ID | Datum, data = dat_L_fried)
pairwise.wilcox.test(
dat_L_fried$Licht_summe,
dat_L_fried$Logger_ID,
paired = TRUE,
p.adjust.method = "BH",
exact = FALSE)
#MN
dat_MN_fried <- summary_daily_logger %>%
filter(Standort == "MN") %>%
arrange(Logger_ID, Datum)
friedman.test(Licht_summe ~ Logger_ID | Datum, data = dat_MN_fried)
#MN
#entfernen der Tage notwendig, an denen ein oder mehrere logger ausgefallen sind
keep_complete_days <- function(data, n_logger = 5) {
data %>%
group_by(Datum) %>%
filter(n_distinct(Logger_ID) == n_logger) %>%
ungroup()
}
#MN
#entfernen der Tage notwendig, an denen ein oder mehrere logger ausgefallen sind
dat_MN_fried <- summary_daily_logger %>%
filter(
Standort == "MN",
is.finite(Licht_summe)
) %>%
group_by(Datum) %>%
filter(n_distinct(Logger_ID) == 5) %>%
ungroup() %>%
arrange(Logger_ID, Datum)
friedman.test(Licht_summe ~ Logger_ID | Datum, data = dat_MN_fried)
pairwise.wilcox.test(
dat_MN_fried$Licht_summe,
dat_MN_fried$Logger_ID,
paired = TRUE,
p.adjust.method = "BH",
exact = FALSE)
#MT
#entfernen der Tage notwendig, an denen ein oder mehrere logger ausgefallen sind
