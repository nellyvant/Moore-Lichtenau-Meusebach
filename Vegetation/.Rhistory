View(layer_deckung)
#mittlere Deckungen
p1 <- Lic_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Kleiner Sumpf"
) +
theme_minimal()
p2 <- MN_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Auf der Pfalz"
) +
theme_minimal()
p3 <- MT_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Fuchshügel"
) +
theme_minimal()
