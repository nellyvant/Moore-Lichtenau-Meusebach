arten_attribute <- veg_long %>%
distinct(Art) %>%
arrange(Art) %>%
mutate(
Wuchsform = NA_character_,
Sukzessionszeiger = NA,
Moorart = NA_character_
)
write_csv(
arten_attribute,
"arten_attribute.csv",
na = ""
)
#anschließend Bearbeitung in Excel, Reimport
attribute<- read.csv("arten_attribute_filled.csv", header=T)
str(attribute)
attribute$Wuchsform<- factor(attribute$Wuchsform)
#join mit veg_long
veg_long <- veg_long %>%
left_join(attribute, by = "Art", relationship = "many-to-one")
str(veg_long)
#Kreuzplot für holzige Arten
woody_plot_data <- veg_long %>%
filter(
Wuchsform == "grass",
Deckung > 0
) %>%
mutate(
x = if_else(Transekt == "WO", Transektnummer, 0),
y = if_else(Transekt == "NS", Transektnummer, 0)
)
woody_plot_data %>%
filter(site == "Lic") %>%
ggplot(
aes(
x = x,
y = y,
color = Art,
size = Deckung
)
) +
geom_point(
position = position_jitter(
width = 0.12,
height = 0.12,
seed = 123
),
alpha = 0.8
) +
coord_equal() +
scale_color_viridis_d(name = "Holzige Art") +
scale_size_continuous(name = "Deckung") +
labs(
x = "West–Ost",
y = "Süd–Nord"
) +
theme_minimal()
#Kreuzplot für holzige Arten
woody_plot_data <- veg_long %>%
filter(
Moorart == TRUE,
Deckung > 0
) %>%
mutate(
x = if_else(Transekt == "WO", Transektnummer, 0),
y = if_else(Transekt == "NS", Transektnummer, 0)
)
woody_plot_data %>%
filter(site == "Lic") %>%
ggplot(
aes(
x = x,
y = y,
color = Art,
size = Deckung
)
) +
geom_point(
position = position_jitter(
width = 0.12,
height = 0.12,
seed = 123
),
alpha = 0.8
) +
coord_equal() +
scale_color_viridis_d(name = "Holzige Art") +
scale_size_continuous(name = "Deckung") +
labs(
x = "West–Ost",
y = "Süd–Nord"
) +
theme_minimal()
woody_plot_data %>%
filter(site == "Lic") %>%
ggplot(
aes(
x = x,
y = y,
color = Art,
size = Deckung
)
) +
geom_point(
position = position_jitter(
width = 0.12,
height = 0.12,
seed = 123
),
alpha = 0.8
) +
coord_equal() +
scale_color_brewer(
name = "Holzige Art",
palette = "Dark2"
) +
scale_size_continuous(name = "Deckung") +
labs(
x = "West–Ost",
y = "Süd–Nord"
) +
theme_minimal()
layer_per_plot<- veg_long%>%
group_by(plot.ID, Schicht) %>%
summarise(Deckung = sum(Deckung, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = Schicht,
values_from = Deckung,
values_fill = 0
)
library(tidyverse)
library(readxl)
library(writexl)
library(vegan)
library(ggplot2)
#| label: read data
#| output: true
vegdata <- read.csv("vegdata_final.csv")
str(vegdata)
#spalten anders ordnen
vegdata <- vegdata %>%
relocate(Transekt, Transektnummer, .after = Name)
str(vegdata)
#entfernen von Arten, die auf der Artenliste waren, aber in keinem der Plots vorkommen
vegdata <- vegdata[, c(
names(vegdata)[1:6],
names(vegdata)[7:ncol(vegdata)][
colSums(vegdata[, 7:ncol(vegdata)], na.rm = TRUE) > 0
]
)]
str(vegdata)
#| label: convert to long format
#| output: false
#Umwandeln zu Long format: 0-Werte bleiben erhalten
rownames(vegdata) <- vegdata$Name
vegdata$Name <- NULL
ncol(vegdata)
str(vegdata)
art_cols <- grep("_(TL|HL|ML|SL)$", names(vegdata), value = TRUE)
veg_long <- vegdata %>%
rownames_to_column("Name") %>%
pivot_longer(cols = all_of(art_cols), names_to = "Art_full", values_to = "Deckung") %>%
tidyr::separate(Art_full, into = c("Art", "Schicht"), sep = "_(?=[A-Z]{1,2}$)")
#sep trennt die Schicht sauber ab, da Arten als Gattung_Epitheton_Schicht vorliegen
str(veg_long)
#abspeichern in Logger für die Deckung der Treelayer in der Analyse der Luftfeuchte
#write.csv2(
#  veg_long,
#  "../Logger/veg_long.csv",
#  row.names = FALSE
#)
#| label: Attribute hinzufügen
arten_attribute <- veg_long %>%
distinct(Art) %>%
arrange(Art) %>%
mutate(
Wuchsform = NA_character_,
Sukzessionszeiger = NA,
Moorart = NA_character_
)
write_csv(
arten_attribute,
"arten_attribute.csv",
na = ""
)
#anschließend Bearbeitung in Excel, Reimport
attribute<- read.csv("arten_attribute_filled.csv", header=T)
str(attribute)
attribute$Wuchsform<- factor(attribute$Wuchsform)
#join mit veg_long
veg_long <- veg_long %>%
left_join(attribute, by = "Art", relationship = "many-to-one")
str(veg_long)
#| label: create subsets
#subsets für jede fläche machen
Lic_subset <- subset(veg_long, site == "Lic")
MN_subset <- subset(veg_long, site =="Meu_nass")
MT_subset <- subset(veg_long, site =="Meu_trock")
#mittlere Deckungen
p1 <- Lic_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 46))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Kleiner Sumpf"
) +
theme_minimal()
p2 <- MN_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Auf der Pfalz"
) +
theme_minimal()
p3 <- MT_subset %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
scale_y_continuous(limits = c(0, 45))+
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Fuchshügel"
) +
theme_minimal()
#p_all <- (p1/p2/p3)+plot_annotation(
#    title = "Top 10 Arten nach mittlerer Deckung",
#    theme = theme(plot.title = element_text(size = 18, face = "bold", hjust = 0.5)))
#ggsave("top10_deckung.png", p_all,
#       width = 14, height = 6, dpi = 300)
dim(p3$data)
p3$data
object.size(p3)
#####Top10 redo#####
p3_data <- MT_subset %>%
select(Art, Deckung) %>%
group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0, na.rm = TRUE),
.groups = "drop"
) %>%
slice_max(
order_by = mean_deckung,
n = 10,
with_ties = FALSE
) %>%
mutate(
Art = reorder(Art, mean_deckung),
label = paste0("n=", n)
) %>%
as.data.frame()
p3 <- ggplot(
p3_data,
aes(x = Art, y = mean_deckung)
) +
geom_col(fill = "darkgreen") +
geom_text(
aes(label = label),
hjust = -0.1,
size = 3
) +
coord_flip() +
scale_y_continuous(limits = c(0, 45)) +
labs(
x = "Art",
y = "Mittlere Deckung %",
title = "Fuchshügel"
) +
theme_minimal()
p3
object.size(p3)
test_plot <- ggplot(
data.frame(x = 1, y = 1),
aes(x, y)
) +
geom_point()
object.size(test_plot)
