geom_segment(
data = arrows,
aes(
x = 0, y = 0,
xend = DCA1 * 2,
yend = DCA2 * 2
),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.25, "cm")),
colour = "black") +
geom_text(
data = arrows,
aes(
x = DCA1 * 2.3,
y = DCA2 * 2.3,
label = Variable
),
inherit.aes = FALSE
) +
labs(
title = "DCA Vegetation Auf der Pfalz",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
