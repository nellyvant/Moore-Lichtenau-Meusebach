layer_prop <- veg_long %>%
group_by(site, Schicht) %>%
summarise(Deckung = mean(Deckung, na.rm = TRUE), .groups = "drop") %>%
group_by(site) %>%
mutate(prop = Deckung / sum(Deckung))
ggplot(layer_prop, aes(x = site, y = prop, fill = Schicht)) +
geom_col() +
labs(y = "Anteil der Deckung", x = NULL) +
theme_minimal()
ggplot(layer_prop, aes(x = site, y = prop, fill = Schicht)) +
geom_col() +
labs(y = "Anteil der Deckung", x = NULL) +
theme_minimal()
View(layer_prop)
layer_prop$Schicht <- factor(
layer_prop$Schicht,
levels = c("ML", "HL", "SL", "TL")
)
ggplot(layer_prop, aes(x = site, y = prop, fill = Schicht)) +
geom_col() +
labs(y = "Anteil der Deckung", x = NULL) +
theme_minimal()
layer_prop$Schicht <- factor(
layer_prop$Schicht,
levels = c("TL", "SL", "HL", "ML")
)
ggplot(layer_prop, aes(x = site, y = prop, fill = Schicht)) +
geom_col() +
labs(y = "Anteil der Deckung", x = NULL) +
theme_minimal()
