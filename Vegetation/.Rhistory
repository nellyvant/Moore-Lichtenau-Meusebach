# 3D Plot
library(plotly)
plot_3d <- merged_data %>%
filter(site == "Lic") %>%
mutate(
x = ifelse(Transekt == "WO", Transektnummer, 0),
y = ifelse(Transekt == "NS", Transektnummer, 0),
z = Weighted_wetness
)
plot_ly(
plot_3d,
x = ~x,
y = ~y,
z = ~z,
color = ~Transekt,
type = "scatter3d",
mode = "lines"
) %>%
plotly::layout(
scene = list(
xaxis = list(title = "WO-Transekt"),
yaxis = list(title = "NS-Transekt"),
zaxis = list(title = "Weighted wetness")
)
)
