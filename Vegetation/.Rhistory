#  breaks = c(1, 3, 5, 7, 9), #bei Zeigerwerten
#  labels = c(1, 3, 5, 7, 9) #bei Zeigerwerten
) +
annotate("text",
x = max(plot_data$x),y = 0,
label = "O",
size = 5,
hjust = 1.4) +
annotate("text",
x = min(plot_data$x),y = 0,
label = "W",
size = 5,
hjust = 1.4) +
annotate("text",
x = 0,y = max(plot_data$y),
label = "N",
size = 5,
vjust = -0.3) +
annotate("text",
x = 0,y = min(plot_data$y),
label = "S",
size = 5,
vjust = 1.3) +
labs(x = NULL, y = NULL)
