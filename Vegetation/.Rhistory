model1 <- glm(
Richness ~
scale(Weighted_light) +
scale(Weighted_temperature) +
scale(Weighted_wetness) +
scale(Hoehe) +
scale(Transektnummer) +
site,
family = poisson,
data = merged_data
)
summary(model1)
library(performance)
check_overdispersion(model1)
check_collinearity(model1)
check_model(model1)
