corrplot(corr_matrix, method ="number")
#note: in keiner der flächen und auch gloabl haben höhe und feuchtezahl eine starke korrleation! entweder meinehöhendaten sind wirlich durch die stauchung nicht zuverlässig oder es besteht einfach kein zusammenhang
library(lme4)
model1 <- glm(
Richness ~
scale(Weighted_light) +
scale(Weighted_temperature) +
scale(Weighted_wetness) +
scale(Hoehe) +
scale(Transektnummer) +
site,
family = poisson,
data = merged_data
)
summary(model1)
library(performance)
check_model(model1)
###Meusebch NAss Nord-> Süd
idx_MN <- merged_data$site == "Meu_nass" & merged_data$Transekt == "NS"
comm_MN <- comm_matrix[idx_MN, , drop = FALSE]
dca <- decorana(comm_MN)
summary(dca)
env_MN <- merged_data %>%
filter(site == "Meu_nass", Transekt=="NS")
fit <- envfit(dca, env_MN[, c("Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Hoehe",
"TL",
"ML",
"HL")])
fit
plot(dca)
arrows <- as.data.frame(scores(fit, display = "vectors"))
arrows$Variable <- rownames(arrows)
arrows$Variable <- c(
"Licht",
"Temperatur",
"Feuchte",
"Stickstoff",
"Basengehalt",
"Höhe",
"Baumschicht",
"Moosschicht",
"Krautschicht"
)
dca_scores <- scores(dca, display = "sites")
dca_df <- as.data.frame(dca_scores)
dca_df$Name <- rownames(dca_df)
dca_df$site <- vegdata$site[match(dca_df$Name, vegdata$plot.ID)]
dca_df$Transektnummer <- vegdata$Transektnummer[match(dca_df$Name, vegdata$plot.ID)]
dca_df$Distanz <- dca_df$Transektnummer
ggplot(dca_df, aes(DCA1, DCA2, colour = Distanz)) +
geom_point(size = 3) +
scale_colour_gradient2(
low = "darkblue",
mid = "red",
high = "darkgreen",
midpoint = 0,
name = "Position im Transekt")+
geom_segment(
data = arrows,
aes(
x = 0, y = 0,
xend = DCA1 * 2,
yend = DCA2 * 2
),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.25, "cm")),
colour = "black") +
geom_text(
data = arrows,
aes(
x = DCA1 * 2.3,
y = DCA2 * 2.3,
label = Variable
),
inherit.aes = FALSE
) +
labs(
title = "DCA Vegetation Auf der Pfalz",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
###mit Arten
species_df <- as.data.frame(scores(dca, display = "species", choices = c(1, 2)))
species_df$Art <- rownames(species_df)
species_totals <- colSums(comm_MN, na.rm = TRUE)
species_df <- species_df %>%
filter(Art %in% names(species_totals[species_totals > 0]))
ggplot(dca_df, aes(DCA1, DCA2, colour = Distanz)) +
geom_point(size = 3) +
geom_text(
data = species_df,
aes(x = DCA1, y = DCA2, label = Art),
inherit.aes = FALSE,
size = 3,
colour = "grey30"
) +
scale_colour_gradient2(
low = "darkblue",
mid = "red",
high = "darkgreen",
midpoint = 0,
name = "Position im Transekt"
) +
geom_segment(
data = arrows,
aes(
x = 0, y = 0,
xend = DCA1 * 2,
yend = DCA2 * 2
),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.25, "cm")),
colour = "black"
) +
geom_text(
data = arrows,
aes(
x = DCA1 * 2.3,
y = DCA2 * 2.3,
label = Variable
),
inherit.aes = FALSE
) +
labs(
title = "DCA Vegetation Auf der Pfalz",
x = "DCA1",
y = "DCA2"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
dca <- decorana(comm_matrix)
# Scores der Aufnahmeflächen
dca_sites <- as.data.frame(
scores(dca, display = "sites", choices = 1:2)
)
dca_sites$plot.ID <- rownames(dca_sites)
dca_sites <- dca_sites %>%
left_join(
vegdata %>%
select(plot.ID, site),
by = "plot.ID"
)
str(dca_sites)
dca_sites$plot.ID <- as.factor(dca_sites$plot.ID)
dca_sites <- dca_sites %>%
left_join(
vegdata %>%
select(plot.ID, site),
by = "plot.ID"
)
str(dca_sites)
# Scores der Aufnahmeflächen
dca_sites <- as.data.frame(
scores(dca, display = "sites", choices = 1:2)
)
str(dca_sites)
dca_sites$plot.ID <- rownames(dca_sites)
str(dca_sites)
dca_sites$plot.ID <- as.integer(dca_sites$plot.ID)
dca_sites <- dca_sites %>%
left_join(
vegdata %>%
select(plot.ID, site),
by = "plot.ID"
)
# Scores der Arten
dca_species <- as.data.frame(
scores(dca, display = "species", choices = 1:2)
)
dca_species$Art <- rownames(dca_species)
ggplot() +
geom_point(
data = dca_sites,
aes(x = DCA1, y = DCA2, color = site),
size = 2
) +
geom_text(
data = dca_species,
aes(x = DCA1, y = DCA2, label = Art),
color = "black",
size = 3,
max.overlaps = 30
) +
labs(
x = "DCA1",
y = "DCA2",
color = "Gebiet"
) +
theme_classic()
View(comm_matrix)
View(veg_long)
comm_moose<- veg_long %>%
filter(Schicht =="ML")
group_by(plot.ID, Art) %>%
summarise(Deckung = sum(Deckung), .groups = "drop") %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("plot.ID")
comm_moose<- veg_long %>%
filter(Schicht =="ML")%>%
group_by(plot.ID, Art) %>%
summarise(Deckung = sum(Deckung), .groups = "drop") %>%
tidyr::pivot_wider(
names_from = Art,
values_from = Deckung,
values_fill = 0
) %>%
tibble::column_to_rownames("plot.ID")
str(comm_moose)
dca <- decorana(comm_moose)
comm_moose <- comm_moose[
rowSums(comm_moose) > 0,
,
drop = FALSE
]
dca <- decorana(comm_moose)
# Scores der Aufnahmeflächen
dca_sites <- as.data.frame(
scores(dca, display = "sites", choices = 1:2)
)
dca_sites$plot.ID <- rownames(dca_sites)
dca_sites$plot.ID <- as.integer(dca_sites$plot.ID)
dca_sites <- dca_sites %>%
left_join(
vegdata %>%
select(plot.ID, site),
by = "plot.ID"
)
# Scores der Arten
dca_species <- as.data.frame(
scores(dca, display = "species", choices = 1:2)
)
dca_species$Art <- rownames(dca_species)
ggplot() +
geom_point(
data = dca_sites,
aes(x = DCA1, y = DCA2, color = site),
size = 2
) +
geom_text(
data = dca_species,
aes(x = DCA1, y = DCA2, label = Art),
color = "black",
size = 3
) +
labs(
x = "DCA1",
y = "DCA2",
color = "Gebiet"
) +
theme_classic()
sq <- grep(
"squarrosum",
colnames(comm_moose),
value = TRUE,
ignore.case = TRUE
)
sq
sum(comm_moose[, sq] > 0)
sum(comm_moose[, sq])
comm_moose[
comm_moose[, sq] > 0,
,
drop = FALSE
]
rowSums(
comm_moose[
comm_moose[, sq] > 0,
,
drop = FALSE
] > 0
)
summayr(dca)
summary(dca)
comm_moose_dca <- comm_moose[
rownames(comm_moose) != "225",
,
drop = FALSE
]
# Sphagnum_squarrosum ist danach eine vollständige Nullspalte
comm_moose_dca <- comm_moose_dca[
,
colSums(comm_moose_dca) > 0,
drop = FALSE
]
dca_moose <- decorana(comm_moose_dca)
summary(dca_moose)
plot(dca_moose)
