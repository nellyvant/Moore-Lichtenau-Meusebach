group_by(Art) %>%
summarise(
mean_deckung = mean(Deckung, na.rm = TRUE),
n = sum(Deckung > 0)
) %>%
arrange(desc(mean_deckung)) %>%
slice_head(n = 10) %>%
ggplot(aes(x = reorder(Art, mean_deckung), y = mean_deckung)) +
geom_col(fill = "darkgreen") +
geom_text(aes(label = paste0("n=", n)),
hjust = -0.1, size = 3) +
coord_flip() +
coord_cartesian(ylim = c(0, 60))+
labs(
x = "Art",
y = "Mittlere Deckung",
title = "Top 10 Arten nach mittlerer Deckung (Lic)"
) +
theme_minimal()
