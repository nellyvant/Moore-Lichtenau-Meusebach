empty_sites
env_summary <- data.frame(
variable = names(env_MN),
n_unique = sapply(env_MN, function(x) length(unique(na.omit(x)))),
sd = sapply(env_MN, function(x) if(is.numeric(x)) sd(x, na.rm = TRUE) else NA),
min = sapply(env_MN, function(x) if(is.numeric(x)) min(x, na.rm = TRUE) else NA),
max = sapply(env_MN, function(x) if(is.numeric(x)) max(x, na.rm = TRUE) else NA)
)
env_summary
###Meusebch NAss Nord-> Süd
idx_MN <- merged_data$site == "Meu_nass" & merged_data$Transekt == "NS"
comm_MN <- comm_matrix[idx_MN, , drop = FALSE]
dca <- decorana(comm_MN)
summary(dca)
env_MN <- merged_data %>%
filter(site == "Meu_nass", Transekt=="NS")
fit <- envfit(dca, env_MN[, c("Weighted_light",
"Weighted_temperature",
"Weighted_wetness",
"Weighted_nitrogen",
"Weighted_alkalinity",
"Hoehe",
"TL",
"ML",
"HL")])
fit
plot(dca)
arrows <- as.data.frame(scores(fit, display = "vectors"))
arrows$Variable <- rownames(arrows)
arrows$Variable <- c(
"Licht",
"Temperatur",
"Feuchte",
"Stickstoff",
"Basengehalt",
"Höhe",
"Baumschicht",
"Moosschicht",
"Krautschicht"
)
