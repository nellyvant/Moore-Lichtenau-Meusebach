select(-Licht_lux_filled)
# ----------------------------
# Variable definieren
var1 <- "Licht_lux"
var2 <- "Temp_sonne_C"
# Datensatz vorbereiten
wide <- all_loggers %>%
select(DateTime, Standort, Logger_ID, all_of(c(var1, var2))) %>%
filter(Standort == "MN") %>%
pivot_wider(
names_from = Logger_ID,
values_from = all_of(c(var1, var2)),
names_sep = "_"
) %>%
arrange(DateTime)
# Zeitliche Features hinzufügen
wide$Hour <- as.numeric(format(wide$DateTime, "%H"))
wide$DayOfYear <- as.numeric(format(wide$DateTime, "%j"))
wide$Hour_sin <- sin(2 * pi * wide$Hour / 24)
wide$Hour_cos <- cos(2 * pi * wide$Hour / 24)
wide$DayOfYear_sin <- sin(2 * pi * wide$DayOfYear / 365)
wide$DayOfYear_cos <- cos(2 * pi * wide$DayOfYear / 365)
# Tag/Nacht-Flag
wide$is_day <- wide$Hour >= 6 & wide$Hour <= 20
# Clear-Sky / Solar-Proxy
wide$clear_sky <- pmax(0,
sin(pi * (wide$Hour - 6) / 12)
) * (1 + 0.4 * sin(2 * pi * wide$DayOfYear / 365))
# Trainingsdaten: nur Tageslicht & echte Messwerte
train <- wide %>%
filter(!is.na(Licht_lux_MNW) & is_day)
# ----------------------------
# Ranger-Modell erstellen (minimalistisch, wie RandomForest)
mod_ranger <- ranger(
formula = Licht_lux_MNW ~ Licht_lux_MNN + Licht_lux_MNM + Temp_sonne_C_MNN + clear_sky,
data = train,
num.trees = 500,
mtry = 4,
importance = "permutation",
splitrule = "variance",
seed = 42
)
# Modellübersicht
mod_ranger
mod_ranger$variable.importance
# ----------------------------
# Vorhersage für alle Werte
pred_ranger <- predict(mod_ranger, data = wide)$predictions
# Nacht = 0 fix
wide$MNW_filled_ranger <- ifelse(
wide$is_day == FALSE,
0,
ifelse(is.na(wide$Licht_lux_MNW), pred_ranger, wide$Licht_lux_MNW)
)
# ----------------------------
# Unabhängige Testung der Vorhersagegenauigkeit
set.seed(42)
valid_idx <- which(!is.na(wide$Licht_lux_MNW) & wide$is_day)
n_reps <- 5
rmse_vals <- numeric(n_reps)
for(i in 1:n_reps){
test_idx <- sample(valid_idx, size = floor(0.2 * length(valid_idx)))
train_idx <- setdiff(valid_idx, test_idx)
train_data <- wide[train_idx, ]
test_data  <- wide[test_idx, ]
mod_cv <- ranger(
formula = Licht_lux_MNW ~ Licht_lux_MNN + Licht_lux_MNM + Temp_sonne_C_MNN + clear_sky,
data = train_data,
num.trees = 500,
mtry = 4,
importance = "permutation",
splitrule = "variance",
seed = 42
)
pred_test <- predict(mod_cv, data = test_data)$predictions
rmse_vals[i] <- sqrt(mean((pred_test - test_data$Licht_lux_MNW)^2))
cat("Wiederholung", i, "fertig\n")
}
# Ergebnisse zusammenfassen
mean_rmse   <- mean(rmse_vals)
sd_rmse     <- sd(rmse_vals)
nrmse_sd    <- mean_rmse / sd(wide$Licht_lux_MNW, na.rm = TRUE)
nrmse_range <- mean_rmse / (max(wide$Licht_lux_MNW, na.rm = TRUE) - min(wide$Licht_lux_MNW, na.rm = TRUE))
range_val <- max(wide$Licht_lux_MNW, na.rm = TRUE) - min(wide$Licht_lux_MNW, na.rm = TRUE)
mean_rmse
sd_rmse
nrmse_sd
nrmse_range
range_val
# ----------------------------
# Ergebnisse zurückführen in Originaldaten
mnw_filled_long_Licht <- wide %>%
select(DateTime, MNW_filled_ranger) %>%
rename(Licht_lux = MNW_filled_ranger) %>%
mutate(Logger_ID = "MNW")
mnw_filled_long_renamed <- mnw_filled_long_Licht %>%
rename(Licht_lux_filled = Licht_lux)
all_loggers_filled <- all_loggers_filled %>%
left_join(
mnw_filled_long_renamed %>% select(DateTime, Logger_ID, Licht_lux_filled),
by = c("DateTime", "Logger_ID")
) %>%
mutate(
Licht_lux = case_when(
Logger_ID == "MNW" & is.na(Licht_lux) ~ round(Licht_lux_filled, 2),
TRUE ~ round(Licht_lux, 2)
)
) %>%
select(-Licht_lux_filled)
#| label: create summary_daily_logger
# Mittelwerte gruppiert nach Loggerstandort und Tag erzeugen, zusätzlich Min & Max Temperatur am Tag
summary_daily_logger <- all_loggers %>%
mutate(Datum = as.Date(DateTime)) %>%
group_by(Standort, Logger,Logger_ID, Datum) %>%
summarise(
Temp_sonne_mean = mean(Temp_sonne_C, na.rm = T),
Temp_sonne_max = max(Temp_sonne_C, na.rm = T),
Temp_sonne_min = min(Temp_sonne_C, na.rm = T),
Temp_sonne_sd = sd(Temp_sonne_C, na.rm = T),
Temp_sonne_range = Temp_sonne_max - Temp_sonne_min,
Temp_schatten_mean = mean(Temp_schatten_C, na.rm = T),
Temp_schatten_max =  max(Temp_schatten_C, na.rm = T),
Temp_schatten_min = min(Temp_schatten_C, na.rm = T),
Temp_schatten_sd = sd(Temp_schatten_C, na.rm = T),
Temp_schatten_range = Temp_schatten_max - Temp_schatten_min,
Licht_mean = mean(Licht_lux, na.rm = T),
Licht_max = max(Licht_lux, na.rm = T),
Licht_min = min(Licht_lux, na.rm = T),
Licht_sd = sd(Licht_lux, na.rm = T),
Licht_range = Licht_max - Licht_min,
Licht_mean_day = mean(Licht_lux[Licht_lux>1], na.rm =T),
rLF_mean = mean(relLF_percent, na.rm = T),
rLF_max = max(relLF_percent, na.rm = T),
rLF_min = min(relLF_percent, na.rm = T),
rLF_sd = sd(relLF_percent, na.rm = T),
rLF_range = rLF_max - rLF_min,
Tp_mean = mean(Taupunkt_C, na.rm = T),
Tp_max = max(Taupunkt_C, na.rm = T),
Tp_min = min(Taupunkt_C, na.rm = T),
Tp_sd = sd(Taupunkt_C, na.rm = T),
Tp_range = Tp_max - Tp_min,
.groups = "drop"
)
