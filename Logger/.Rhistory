#| label: create table of day&time of min&max temperature
daily_logger_extrema <- all_loggers %>%
mutate(Datum = as.Date(DateTime)) %>%
group_by(Standort, Logger,Logger_ID, Datum) %>%
summarise(
## SONNE
Temp_sonne_max =max(Temp_sonne_C, na.rm = TRUE),
Time_sonne_max = DateTime[which.max(replace_na(Temp_sonne_C, -Inf))],
Temp_sonne_min =min(Temp_sonne_C, na.rm = TRUE),
Time_sonne_min =DateTime[which.max(replace_na(Temp_sonne_C, -Inf))],
## SCHATTEN
#Temp_schatten_max =
#      if (all(is.na(Temp_schatten_C))) NA_real_
#      else max(Temp_schatten_C, na.rm = TRUE),
#    Time_schatten_max =
#      if (all(is.na(Temp_schatten_C))) as.POSIXct(NA)
#      else DateTime[which.max(Temp_schatten_C)],
#    Temp_schatten_min =
#      if (all(is.na(Temp_schatten_C))) NA_real_
#      else min(Temp_schatten_C, na.rm = TRUE),
#    Time_schatten_min =
#      if (all(is.na(Temp_schatten_C))) as.POSIXct(NA)
#      else DateTime[which.min(Temp_schatten_C)],
.groups = "drop"
)
#Auswertung
extrema_logger <- daily_logger_extrema %>%
group_by(Standort, Logger,Logger_ID) %>%
summarise(
# Sonne
Sonne_max = max(Temp_sonne_max, na.rm = TRUE),
Sonne_max_Zeit = Time_sonne_max[which.max(Temp_sonne_max)],
Sonne_min = min(Temp_sonne_min, na.rm = TRUE),
Sonne_min_Zeit = Time_sonne_min[which.min(Temp_sonne_min)],
# Schatten
#    Schatten_max = max(Temp_schatten_max, na.rm = TRUE),
#    Schatten_max_Zeit = Time_schatten_max[which.max(Temp_schatten_max)],
#    Schatten_min = min(Temp_schatten_min, na.rm = TRUE),
#    Schatten_min_Zeit = Time_schatten_min[which.min(Temp_schatten_min)]
.groups = "drop" )
summary(extrema_logger)
#| label: temperature ranges all areas
extrema_logger <- extrema_logger %>%
left_join(summary_logger_year %>%
select(Standort, Logger, Logger_ID, Tempschatten_Jahresmittel),
by = c("Standort","Logger","Logger_ID"))
str(extrema_logger)
ggplot(extrema_logger, aes(x = Logger)) +
geom_linerange(aes(ymin = Sonne_min, ymax = Sonne_max, color = Standort),
size = 1) +
geom_point(aes(y = Tempschatten_Jahresmittel, color = Standort),
size = 3) +
geom_text(aes(y = Sonne_min, label = format(Sonne_min_Zeit, "%d.%m")),
vjust = 1.5,
size = 3,
check_overlap = TRUE) +
geom_text(aes(y = Sonne_max, label = format(Sonne_max_Zeit, "%d.%m")),
vjust = -0.5,
size = 3,
check_overlap = TRUE) +
facet_wrap(~Standort, scales = "free_x", nrow = 1) +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(
x = "Logger",
y = "Temperatur [°C]",
title = "Temperaturspitzen und Mittelwert pro Logger und Standort"
)
