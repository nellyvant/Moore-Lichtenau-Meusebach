#Test auf Normalverteilung am Standort Lichtenau
trockenl %>%
filter(Standort == "L") %>%
ggqqplot(
x = "delta_LF",
facet.by = "Logger",
add = "qqline"
)
trockenl %>%
filter(Standort == "L") %>%
ggplot(aes(x = delta_LF)) +
geom_histogram(bins = 10) +
facet_wrap(~ Logger, scales = "free")
shapiro.test(trockenl$delta_LF[trockenl$Standort == "L"])
#keine Normalverteilung
#friedman test
dat_L_fried <- summary_daily_logger %>%
filter(Standort == "L") %>%
arrange(Logger_ID, Datum)
dat_rLF_L<- trockenl %>%
filter(Standort =="L")%>%
arrange(Logger_ID, Datum)
friedman.test( delta_LF ~ Logger_ID | Datum, data = dat_rLF_L)
pairwise.wilcox.test(
dat_rLF_L$delta_LF,
dat_rLF_L$Logger_ID,
paired = TRUE,
p.adjust.method = "BH",
exact = FALSE
)
#boxplot
dat_rLF_L %>%
group_by(Logger_ID) %>%
summarise(
n = sum(!is.na(delta_LF)),
Median = median(delta_LF, na.rm = TRUE),
IQR = IQR(delta_LF, na.rm = TRUE)
) %>%
arrange(Median)
ggplot(dat_rLF_L, aes(x = Logger_ID, y = delta_LF)) +
geom_boxplot() +
geom_jitter(width = 0.1, alpha = 0.3) +
labs(x = "Logger", y = "delta_LF") +
theme_classic()
#deltaLF negativ -> Austrocknung
#deltaLF positiv -> selbst ohne regen wird es feuchter
#dieser Plot zeigt, in der Mitte nimmt die Luftfeuchte stärker ab als an den Rändern -> kann an Schatten liegen, Deckung der Bäume, Temperatur usw, dafür brauchen wir ein Model
#Wenn kein model ausreichend Varianz erklärt, müssten andere Methoden verwendet werden, um die Frage zu beantworten
#Deckung TL
veg_long <- read_excel("veg_long.xlsx")
read.csv("veg_long.csv", header=T)# funktioniert bei mir irgendwie nicht!?
deckung_TL <- veg_long %>%
filter(
Schicht == "TL",
Transekt %in% c("NS", "WO")
) %>%
group_by(site, Transekt) %>%
filter(
Transektnummer == min(Transektnummer, na.rm = TRUE) |
Transektnummer == max(Transektnummer, na.rm = TRUE) |
Transektnummer == 0
) %>%
ungroup() %>%
group_by(
site,
Transekt,
Transektnummer,
Name,
plot.ID,
arbeitsname
) %>%
summarise(
Deckung_TL = sum(Deckung, na.rm = TRUE),
.groups = "drop"
)
deckung_TL
deckung_TL <- deckung_TL %>%
group_by(site, Transekt) %>%
mutate(
logger = case_when(
Transektnummer == 0 ~ "M",
Transekt == "NS" &
Transektnummer == min(Transektnummer, na.rm = TRUE) ~ "S",
Transekt == "NS" &
Transektnummer == max(Transektnummer, na.rm = TRUE) ~ "N",
Transekt == "WO" &
Transektnummer == min(Transektnummer, na.rm = TRUE) ~ "W",
Transekt == "WO" &
Transektnummer == max(Transektnummer, na.rm = TRUE) ~ "O",
TRUE ~ NA_character_
)
) %>%
ungroup()
deckung_TL
# Modell zur Klärung der Frage: Was verursacht die starken Schwankungen in der Luftfeuchte
# -> Welche Variablen treiben deltaLF?
# Test ob Baumdeckung und Position im Transekt gekoppelt sind - das heißt man schaut erstmal ob man die Baumdeckung als unabhängige Variable verwenden kann
ggplot(deckung_TL,
aes(x = Transektnummer, y = Deckung_TL)) +
geom_point() +
geom_smooth(method = "lm")
cor.test(deckung_TL$Transektnummer,
deckung_TL$Deckung_TL,
method = "spearman")
kruskal.test(Deckung_TL ~ site, data = deckung_TL)
kruskal.test(Deckung_TL ~ Transekt, data = deckung_TL)
# Baumdeckung scheint weder stark standortabhängig noch transektabhängig zu sein
#################################################################
#Daten für das Mdell vorbereiten, in model_data zusammenführen
deckung_clean <- deckung_TL %>%
group_by(Standort, logger) %>%
summarise(Deckung_TL = mean(Deckung_TL), .groups = "drop")
#################################################################
#Daten für das Mdell vorbereiten, in model_data zusammenführen
deckung_TL <- deckung_TL %>%
mutate(
Standort = case_when(
site == "Meu_nass"   ~ "MN",
site == "Meu_trock"  ~ "MT",
site == "Lic"        ~ "L",
TRUE ~ NA_character_
)
)
deckung_clean <- deckung_TL %>%
group_by(Standort, logger) %>%
summarise(Deckung_TL = mean(Deckung_TL), .groups = "drop")
model_data <- trockenl %>%
left_join(deckung_clean, by = c("Standort", "Logger" = "logger"))
table(is.na(model_data$Deckung_TL))
table(model_data$Standort, is.na(model_data$Deckung_TL))
str(model_data)
#Modell über alle Standorte
mod <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Tp_mean + Standort +
(1 | Logger),
data = model_data
)
summary(mod)
model_data_scaled <- model_data %>%
mutate(
delta_LF_z = scale(delta_LF),
Deckung_z = scale(Deckung_TL),
Regen_z = scale(Tage_seit_Regen),
Temp_z = scale(Tp_mean)
)
lmer(delta_LF_z ~ Deckung_z + Regen_z + Temp_z + (1 | Logger),
data = model_data_scaled)
#Temperatur: 0.12671 - stärksten Effekt
#Deckung_TL: 0.11481 - fast den selben Effekt wie Temp
#Tage seit Regen: 0.05659 - geringeren Effekt
r2(mod)
#Marginal R² = 0.042 -> Temperatur, Regen, Deckung, Standort erklären 4.2% der Variation in delta_LF
#Conditional R² = 0.149 -> gesamtes Modell (inkl. Logger) erklärt   14.9% der Variation
# = Modell erklärt nur einen kleinen Teil der Luftfeuchte-Dynamik!!
################################################################
#Modell für Standort Meusebach nass
data_MN <- model_data %>%
filter(Standort == "MN")
mod_MN <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Tp_mean + (1 | Logger),
data = data_MN
)
summary(mod_MN)
#Temperatur: nicht signifikant, p = 0,0688
#Deckung_TL: nicht signifikant, p = 0.5888
#Tage seit Regen: nicht signifikant, p = 0.0612
###############################################################
#Modell für Standort Meusebach trocken
data_MT <- model_data %>%
filter(Standort == "MT")
mod_MT <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Tp_mean + (1 | Logger),
data = data_MT
)
summary(mod_MT)
#Temperatur: nicht signifikant, p = 0,243
#Deckung_TL: nicht signifikant, p = 0.54
#Tage seit Regen: nicht signifikant, p = 0.144
##############################################################
#Modell für Standort Lichtenau
data_L <- model_data %>%
filter(Standort == "L")
mod_L <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Tp_mean + (1 | Logger),
data = data_L
)
summary(mod_L)
#Temperatur: signifikant, p = 0,0246, Estimate: 0.129
#Deckung_TL: nicht signifikant, p = 0.0664
#Tage seit Regen: nicht signifikant, p = 0.1594
