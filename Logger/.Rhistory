Standort == "MN",
is.finite(rLF_mean)
) %>%
mutate(
Datum = factor(Datum),
Logger = factor(Logger))
ANOVA_MN <- aov_car(
rLF_mean ~ Logger + Error(Datum / Logger),
data = dat_MN)
summary(ANOVA_MN)
PostHoc_MN <- emmeans(ANOVA_MN, specs = "Logger")
pairs(PostHoc_MN, adjust = "bonferroni")
