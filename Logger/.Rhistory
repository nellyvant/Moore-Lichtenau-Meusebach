flaechen_namen <- c(
"L" = "Kleiner Sumpf",
"MN" = "Auf der Pfalz",
"MT" = "Fuchshügel")
ggplot(extrema_logger, aes(x = Logger)) +
geom_linerange(aes(ymin = Sonne_min, ymax = Sonne_max, color = Standort),
size = 1) +
geom_point(aes(y = Tempschatten_Jahresmittel, color = Standort),
size = 3) +
geom_text(aes(y = Sonne_min, label = format(Sonne_min_Zeit, "%d.%m.")),
vjust = 1.5,
size = 3,
check_overlap = TRUE) +
geom_text(aes(y = Sonne_max, label = format(Sonne_max_Zeit, "%d.%m.")),
vjust = -0.5,
size = 3,
check_overlap = TRUE) +
facet_wrap(~Standort, scales = "free_x", nrow = 1, labeller = labeller(Standort = flaechen_namen))+
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),legend.position = "none") +
labs(
x = "Logger",
y = "Temperatur [°C]",
title = "Temperaturspitzen und Mittelwert pro Logger und Standort"
)
