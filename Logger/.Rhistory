model_data <- trockenl %>%
left_join(deckung_clean, by = c("Standort", "Logger" = "logger"))
table(is.na(model_data$Deckung_TL))
table(model_data$Standort, is.na(model_data$Deckung_TL))
str(model_data)
#Modell über alle Standorte
mod <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Temp_schatten_mean + Standort +
(1 | Logger),
data = model_data
)
#Modell über alle Standorte
mod <- lmer(
delta_LF ~ Deckung_TL + Tage_seit_Regen + Temp_schatten_mean + Standort +
(1 | Logger_ID),
data = model_data
)
as.data.frame(VarCorr(mod))
model_data %>%
count(Logger_ID) %>%
arrange(n)
summary(mod)
#Random effects:
# Groups    Name        Variance Std.Dev.
# Logger_ID (Intercept)  0.00    0.000
#Logger_ID erklrt keine Effekte, daher wechsel zu einem lm
mod_lm <- lm(
delta_LF ~ Deckung_TL + Tage_seit_Regen +
Temp_schatten_mean + Standort,
data = model_data
)
summary(mod_lm)
mod_lm2<-update(mod_lm,~.-Temp_schatten_mean)
anova(mod_lm, mod_lm2)
#p=0,97
summary(mod_lm2)
mod_lm3<-update(mod_lm2,~.-Deckung_TL)
anova(mod_lm2, mod_lm3)
#p=0,6
summary(mod_lm3)
#ermöglicht Vergleich der Variabeln, so dass man ermitteln kann welcher Effekt den größten Einfluss hat
model_data_scaled <- model_data %>%
mutate(
delta_LF_z = scale(delta_LF),
Deckung_z = scale(Deckung_TL),
Regen_z = scale(Tage_seit_Regen),
Temp_z = scale(Temp_schatten_mean)
)
mod_scaled <-lmer(delta_LF_z ~ Deckung_z + Regen_z + Temp_z + (1 | Logger_ID),
data = model_data_scaled)
r2(mod_lm3)
#p=0,6
summary(mod_lm3)
