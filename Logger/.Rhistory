# Modellübersicht -> man kann ableiten, wie wichtig die einzelnen Features waren (also: MTN, MTS, Hour_sin,Weekday, DayOfYear ...)
mod_rf
importance(mod_rf)
pred_rf <- predict(mod_rf, newdata = wide)
pred_rf <- predict(mod_rf, newdata = wide)
pred_rf <- round(pred_rf, 2)
wide$MTM_filled_rf <- ifelse(
is.na(wide$MTM),
pred_rf,
wide$MTM
)
# RMSE validieren (wie vorher)
set.seed(42)
n_reps <- 5
rmse_vals <- numeric(n_reps)
for(i in 1:n_reps){
valid_idx <- which(!is.na(wide$MTM))
idx <- sample(
valid_idx,
size = floor(0.2 * length(valid_idx))
)
wide_test <- wide
wide_test$MTM[idx] <- NA
pred_test_rf <- predict(mod_rf, newdata = wide_test)
rmse_vals[i] <- sqrt(mean(
(pred_test_rf[idx] - wide$MTM[idx])^2
))
cat("Wiederholung", i, "fertig\n")
}
for(i in 1:n_reps){
valid_idx <- which(!is.na(wide$MTM))
idx <- sample(
valid_idx,
size = floor(0.2 * length(valid_idx))
)
wide_test <- wide
wide_test$MTM[idx] <- NA
pred_test_rf <- predict(mod_rf, newdata = wide_test)
rmse_vals[i] <- sqrt(mean(
(pred_test_rf[idx] - wide$MTM[idx])^2
))
cat("Wiederholung", i, "fertig\n")
}
mean_rmse <- mean(rmse_vals)
sd_rmse   <- sd(rmse_vals)
nrmse     <- mean_rmse / sd(wide$MTM, na.rm = TRUE)
mean_rmse # Taupunkt: weicht ca. 0,20 °C von den echten Werten ab
sd_rmse # SD: 0,002 -> bei 5 Wiederholungen fast identische Ergebnisse = stabiles Modell, keine Zufallseffekte
nrmse # Fehler relativ zur natürlichen Streuung: 0,060 -> Fehler ist relativ klein im Verhältnis zur natürlichen Variabilität
# erzeugte Daten wieder in die Originaltabelle einfügen
mtm_filled_long_Tau <- wide %>%
select(DateTime, MTM_filled_rf) %>%
rename(Taupunkt_C = MTM_filled_rf) %>%
mutate(Logger_ID = "MTM")
mtm_filled_long_renamed <- mtm_filled_long_Tau %>%
rename(Taupunkt_C_filled = Taupunkt_C)
all_loggers_filled <- all_loggers_filled %>%
left_join(
mtm_filled_long_renamed %>% select(DateTime, Logger_ID, Taupunkt_C_filled),
by = c("DateTime", "Logger_ID")
) %>%
mutate(
Taupunkt_C = case_when(
Logger_ID == "MTM" & is.na(Taupunkt_C) ~ round(Taupunkt_C_filled, 2),
TRUE ~ round(Taupunkt_C, 2)  # auch die übrigen Werte runden
)
) %>%
select(-Taupunkt_C_filled)
View(all_loggers_filled)
