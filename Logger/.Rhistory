x = "Temp_area_sonne_sd",
facet.by = "Standort",
add = "qqline")
summary_daily_area %>%
ggplot(aes(x = Temp_area_sonne_sd)) +
geom_histogram(bins = 10) +
facet_grid(~ Standort, scales = "free")
#eher keine Normalverteilung gegeben
#Vergleich Tagesmaxima (Sonne)
summary_daily_area %>%
ggqqplot(
x = "Temp_area_sonne_max",
facet.by = "Standort",
add = "qqline")
summary_daily_area %>%
ggplot(aes(x = Temp_area_sonne_max)) +
geom_histogram(bins = 10) +
facet_grid(~ Standort, scales = "free")
#keine Normalverteilung gegeben
dat_area <- summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
filter(n_distinct(Standort) == 3) %>%
ungroup() %>%
mutate(
Datum = factor(Datum),
Standort = factor(Standort)
)
ANOVA_area <- aov_car(
Temp_area_schatten_mean ~ Standort + Error(Datum / Standort),
data = dat_area
)
summary(ANOVA_area)
PostHoc_area <- emmeans(ANOVA_area, specs = "Standort")
pairs(PostHoc_area, adjust = "bonferroni")
# Anzahl der entfernten Tage prüfen
summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
summarise(n = n_distinct(Standort)) %>%
summarise(valid_days = sum(n == 3))
#Tests ergaben signifikante Unterschiede zwischen L und den beiden anderen Flächen (MN und MT), während zwischen MN und MT kein signifikanter Unterschied bestand.
dat_temp <- summary_daily_area %>%
filter(is.finite(Temp_area_schatten_sd)) %>%
group_by(Datum) %>%
filter(n_distinct(Standort) == 3) %>%
ungroup()
friedman.test(
Temp_area_schatten_sd ~ Standort | Datum,
data = dat_temp
)
pairwise.wilcox.test(
dat_temp$Temp_area_schatten_sd,
dat_temp$Standort,
paired = TRUE,
p.adjust.method = "BH"
)
#Alle drei Flächen unterscheiden sich signifikant in der Temperaturvariabilität (Schatten).
summary_daily_area %>%
group_by(Standort) %>%
summarise(
mean_daily_sd = mean(Temp_area_schatten_sd, na.rm = TRUE),
median_daily_sd = median(Temp_area_schatten_sd, na.rm = TRUE)
)
