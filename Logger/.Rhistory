# NodePurity sagt strukturbezogen, wie wichtig ein Feature für die Baumaufteilung ist
pred_rf <- predict(mod_rf, newdata = wide)
wide$MTW_filled_rf <- ifelse(
is.na(wide$MTW),
pred_rf,
wide$MTW
)
# RMSE validieren (wie vorher)
set.seed(42)
n_reps <- 5 # Anzahl der Wiederholungen
rmse_vals <- numeric(n_reps) # speichert die werte der 5 Wiederholungen
for(i in 1:n_reps){
valid_idx <- which(!is.na(wide$MTW)) # nur echte Messwerte auswählen
idx <- sample(
valid_idx,
size = floor(0.2 * length(valid_idx)) # zufällig 20% der Werte auswählen
)
wide_test <- wide # Kopie erzeugen
wide_test$MTW[idx] <- NA # künstlich 20% auf NA setzen
pred_test_rf <- predict(mod_rf, newdata = wide_test) # Vorhersage mit Modell
rmse_vals[i] <- sqrt(mean(
(pred_test_rf[idx] - wide$MTW[idx])^2
)) # RMSE berechnen
cat("Wiederholung", i, "fertig\n") # Fortschrittsanzeige unten in der Console
}
mean_rmse <- mean(rmse_vals) # Mittelwert
sd_rmse   <- sd(rmse_vals) # Standardabweichung
nrmse     <- mean_rmse / sd(wide$MTW, na.rm = TRUE) # Fehler relativ zur natürlichen Streuung
mean_rmse # Relative Luftfeuchte: weicht ca. 1,503 % von den echten Werten ab
sd_rmse # SD: 0,027 -> bei 5 Wiederholungen sehr ähnliche identische Ergebnisse = stabiles Modell, keine Zufallseffekte
nrmse # NRMSE: 0,093 -> Fehler ist relativ klein im Verhältnis zur natürlichen Variabilität
# erzeugte Daten wieder in die Originaltabelle einfügen
mtw_filled_long_Tau <- wide %>%
select(DateTime, MTW_filled_rf) %>%
rename(Taupunkt_C = MTW_filled_rf) %>%
mutate(Logger_ID = "MTW")
mtw_filled_long_renamed <- mtw_filled_long_Tau %>%
rename(Taupunkt_C_filled = Taupunkt_C)
all_loggers_filled <- all_loggers_filled %>%
left_join(
mtw_filled_long_renamed %>% select(DateTime, Logger_ID, Taupunkt_C_filled),
by = c("DateTime", "Logger_ID")
) %>%
mutate(
Taupunkt_C = case_when(
Logger_ID == "MTW" & is.na(Taupunkt_C) ~ round(Taupunkt_C_filled, 2),
TRUE ~ round(Taupunkt_C, 2)  # auch die übrigen Werte runden
)
) %>%
select(-Taupunkt_C_filled)
View(mtw_filled_long_RL)
View(mtw_filled_long_renamed)
