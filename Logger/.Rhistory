# Licht
#hier wäre es für die Mittelwerte mal spannend die Nacht (0 lux) auszuklammern und nur die Tagwerte anzuschauen, dazu die Sonnenscheindauer pro Tag bei jedem Logger
# um Mondlicht auszuschließen ist Sonnenaufgang/Untergang bei 1 lux als Grenzwert festgelegt
licht <- all_loggers %>%
mutate(Datum = as.Date(DateTime)) %>%
group_by(Logger_ID, Datum) %>%
summarise(
Licht_mean = mean(Licht_lux, na.rm = T),
Licht_max = max(Licht_lux, na.rm = T),
Licht_min = min(Licht_lux, na.rm = T),
Licht_sd = sd(Licht_lux, na.rm = T),
Licht_range = Licht_max - Licht_min,
Licht_mean_day = mean(Licht_lux[Licht_lux>1], na.rm =T),
Sonnenaufgang = min(DateTime[Licht_lux > 1], na.rm = TRUE),
Sonnenuntergang  = max(DateTime[Licht_lux > 1], na.rm = TRUE),
Tageslicht = as.numeric(difftime(Sonnenuntergang, Sonnenaufgang, units = "hours")),
.groups = "drop")
summary(licht)
