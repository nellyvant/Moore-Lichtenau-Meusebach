arrange(desc(Median))
#MN
#entfernen der Tage notwendig, an denen ein oder mehrere logger ausgefallen sind
dat_MN_fried <- summary_daily_logger %>%
filter(
Standort == "MN",
is.finite(Temp_sonne_range)
) %>%
group_by(Datum) %>%
filter(n_distinct(Logger_ID) == 5) %>%
ungroup() %>%
arrange(Logger_ID, Datum)
######friedman konkrete estimates oder so berehcnen#####
dat_MN_fried %>%
group_by(Logger_ID) %>%
summarise(
n_Tage = n(),
Median = median(Temp_sonne_max, na.rm = TRUE),
IQR = IQR(Licht_summe, na.rm = TRUE),
Mittelwert = mean(Temp_sonne_max, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(Median))
######friedman konkrete estimates oder so berehcnen#####
dat_MN_fried %>%
group_by(Logger_ID) %>%
summarise(
n_Tage = n(),
Median = median(Licht_summe, na.rm = TRUE),
IQR = IQR(Licht_summe, na.rm = TRUE),
Mittelwert = mean(Licht_summe, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(Median))
