group_by(Standort, Logger,Logger_ID) %>%
summarise(
Tempsonne_Jahresmittel = mean(Temp_sonne_C, na.rm = TRUE),
Tempsonne_Jahres_sd = sd(Temp_sonne_C, na.rm = TRUE),
Tempsonne_Jahres_min = min(Temp_sonne_C, na.rm = TRUE),
Tempsonne_Jahres_max = max(Temp_sonne_C, na.rm = TRUE),
Tempsonne_Jahres_range = Tempsonne_Jahres_max - Tempsonne_Jahres_min,
Tempschatten_Jahresmittel = mean(Temp_schatten_C, na.rm = TRUE),
Tempschatten_Jahres_sd = sd(Temp_schatten_C, na.rm = TRUE),
Tempschatten_Jahres_min = min(Temp_schatten_C, na.rm = TRUE),
Tempschatten_Jahres_max = max(Temp_schatten_C, na.rm = TRUE),
Tempschatten_Jahres_range = Tempschatten_Jahres_max - Tempschatten_Jahres_min,
Licht_Jahresmittel = mean(Licht_lux, na.rm = TRUE),
Licht_Jahres_sd = sd(Licht_lux, na.rm = TRUE),
Licht_Jahres_min = min(Licht_lux, na.rm = TRUE),
Licht_Jahres_max = max(Licht_lux, na.rm = TRUE),
Licht_Jahres_mean_day = mean(Licht_lux[Licht_lux>1], na.rm =T),
Licht_Jahres_range = Licht_Jahres_max - Licht_Jahres_min,
rLF_Jahresmittel = mean(relLF_percent, na.rm = TRUE),
rLF_Jahres_sd = sd(relLF_percent, na.rm = TRUE),
rLF_Jahres_min = min(relLF_percent, na.rm = TRUE),
rLF_Jahres_max = max(relLF_percent, na.rm = TRUE),
rLF_Jahres_range = rLF_Jahres_max - rLF_Jahres_min,
Tp_Jahresmittel = mean(Taupunkt_C, na.rm = TRUE),
Tp_Jahres_sd = sd(Taupunkt_C, na.rm = TRUE),
Tp_Jahres_min = min(Taupunkt_C, na.rm = TRUE),
Tp_Jahres_max = max(Taupunkt_C, na.rm = TRUE),
Tp_Jahres_range = Tp_Jahres_max - Tp_Jahres_min,
.groups = "drop"
)
summary(summary_logger_year)
sd_summary_logger <- summary_daily_logger %>%
group_by(Standort, Logger, Logger_ID) %>%
summarise(
Temp_schatten_sd_mean = mean(Temp_schatten_sd, na.rm = TRUE),
Temp_schatten_sd_median = median(Temp_schatten_sd, na.rm = TRUE),
Temp_schatten_range_mean = mean(Temp_schatten_range, na.rm = TRUE),
Temp_schatten_range_median = median(Temp_schatten_range, na.rm = TRUE),
Temp_sonne_sd_mean = mean(Temp_sonne_sd, na.rm = TRUE),
Temp_sonne_sd_median = median(Temp_sonne_sd, na.rm = TRUE),
Temp_sonne_range_mean = mean(Temp_sonne_range, na.rm = TRUE),
Temp_sonne_range_median = median(Temp_sonne_range, na.rm = TRUE),
Licht_sd_mean = mean(Licht_sd, na.rm = TRUE),
Licht_sd_median = median(Licht_sd, na.rm = TRUE),
Licht_range_mean = mean(Licht_range, na.rm = TRUE),
Licht_range_median = median(Licht_range, na.rm = TRUE),
rLF_sd_mean = mean(rLF_sd, na.rm = TRUE),
rLF_sd_median = median(rLF_sd, na.rm = TRUE),
rLF_range_mean = mean(rLF_range, na.rm = TRUE),
rLF_range_median = median(rLF_range, na.rm = TRUE),
Tp_sd_mean = mean(Tp_sd, na.rm = TRUE),
Tp_sd_median = median(Tp_sd, na.rm = TRUE),
Tp_range_mean = mean(Tp_range, na.rm = TRUE),
Tp_range_median = median(Tp_range, na.rm = TRUE),
.groups = "drop"
)
sd_summary_logger
