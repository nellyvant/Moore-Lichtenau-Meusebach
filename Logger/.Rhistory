#| label: create summary_area_total
summary_area_total <- all_loggers %>%
group_by(Standort) %>%
summarise(
Temp_area_sonne_mean = mean(Temp_sonne_C, na.rm = TRUE),
Temp_area_sonne_max = max(Temp_sonne_C, na.rm = TRUE),
Temp_area_sonne_min = min(Temp_sonne_C, na.rm = TRUE),
Temp_area_sonne_sd = sd(Temp_sonne_C, na.rm = TRUE),
Temp_area_sonne_range = Temp_area_sonne_max - Temp_area_sonne_min,
Temp_area_schatten_mean = mean(Temp_schatten_C, na.rm = TRUE),
Temp_area_schatten_max = max(Temp_schatten_C, na.rm = TRUE),
Temp_area_schatten_min = min(Temp_schatten_C, na.rm = TRUE),
Temp_area_schatten_sd = sd(Temp_schatten_C, na.rm = TRUE),
Temp_area_schatten_range = Temp_area_schatten_max - Temp_area_schatten_min,
Licht_area_mean = mean(Licht_lux, na.rm = TRUE),
Licht_area_max = max(Licht_lux, na.rm = TRUE),
Licht_area_min = min(Licht_lux, na.rm = TRUE),
Licht_area_sd = sd(Licht_lux, na.rm = TRUE),
Licht_area_range = Licht_area_max - Licht_area_min,
Licht_area_mean_day = mean(Licht_lux[Licht_lux > 1], na.rm = TRUE),
Licht_summe = sum(Licht_lux * 10, na.rm = TRUE),
rLF_area_mean = mean(relLF_percent, na.rm = TRUE),
rLF_area_max = max(relLF_percent, na.rm = TRUE),
rLF_area_min = min(relLF_percent, na.rm = TRUE),
rLF_area_sd = sd(relLF_percent, na.rm = TRUE),
rLF_area_range = rLF_area_max - rLF_area_min,
Tp_area_mean = mean(Taupunkt_C, na.rm = TRUE),
Tp_area_max = max(Taupunkt_C, na.rm = TRUE),
Tp_area_min = min(Taupunkt_C, na.rm = TRUE),
Tp_area_sd = sd(Taupunkt_C, na.rm = TRUE),
Tp_area_range = Tp_area_max - Tp_area_min,
.groups = "drop"
)
str(summary_area_total)
View(summary_area_total)
