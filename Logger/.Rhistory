summary_daily_logger %>%
filter(Standort == "L") %>%
ggplot(aes(x=Logger,fill = Logger, y=Licht_summe)) +
geom_boxplot(width=0.8)+
labs(title ="Lichtverhältnisse Kleiner Sumpf ",
x="Logger",
y="kumulative Lichtinensität (Lux x Zeit)")
View(summary_daily_logger)
dat_L <- summary_daily_logger %>%
filter(Standort == "L") %>%
select(Datum, Logger, Licht_summe) %>%
pivot_wider(
names_from = Logger,
values_from = Licht_summe
)
logger <- c("M", "N", "O", "S", "W")
ergebnisse <- combn(logger, 2, simplify = FALSE)
tests <- lapply(ergebnisse, function(x) {
test <- t.test(
dat_L[[x[1]]],
dat_L[[x[2]]],
paired = TRUE
)
data.frame(
Gruppe1 = x[1],
Gruppe2 = x[2],
p_Wert = test$p.value,
Mittelwert_Diff = mean(dat_L[[x[1]]] - dat_L[[x[2]]],
na.rm = TRUE)
)
})
tests_df <- bind_rows(tests)
tests_df
