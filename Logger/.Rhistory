#keine Normalverteilung gegeben
dat_area <- summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
filter(n_distinct(Standort) == 3) %>%
ungroup() %>%
mutate(
Datum = factor(Datum),
Standort = factor(Standort)
)
ANOVA_area <- aov_car(
Temp_area_schatten_mean ~ Standort + Error(Datum / Standort),
data = dat_area
)
summary(ANOVA_area)
PostHoc_area <- emmeans(ANOVA_area, specs = "Standort")
pairs(PostHoc_area, adjust = "bonferroni")
# Anzahl der entfernten Tage prüfen
summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
summarise(n = n_distinct(Standort)) %>%
summarise(valid_days = sum(n == 3))
#Tests ergaben signifikante Unterschiede zwischen L und den beiden anderen Flächen (MN und MT), während zwischen MN und MT kein signifikanter Unterschied bestand.
dat_temp <- summary_daily_area %>%
filter(is.finite(Temp_area_schatten_sd)) %>%
group_by(Datum) %>%
filter(n_distinct(Standort) == 3) %>%
ungroup()
friedman.test(
Temp_area_schatten_sd ~ Standort | Datum,
data = dat_temp
)
pairwise.wilcox.test(
dat_temp$Temp_area_schatten_sd,
dat_temp$Standort,
paired = TRUE,
p.adjust.method = "BH"
)
