dat_area <- summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
filter(n_distinct(Standort) == 3) %>%
ungroup() %>%
mutate(
Datum = factor(Datum),
Standort = factor(Standort)
)
ANOVA_area <- aov_car(
Temp_area_schatten_mean ~ Standort + Error(Datum / Standort),
data = dat_area
)
summary(ANOVA_area)
PostHoc_area <- emmeans(ANOVA_area, specs = "Standort")
pairs(PostHoc_area, adjust = "bonferroni")
# Anzahl der entfernten Tage prüfen
summary_daily_area %>%
filter(is.finite(Temp_area_schatten_mean)) %>%
group_by(Datum) %>%
summarise(n = n_distinct(Standort)) %>%
summarise(valid_days = sum(n == 3))
dat_MT <- summary_daily_logger %>%
filter(
Standort == "MT",
is.finite(Temp_schatten_mean)
) %>%
mutate(
Datum = factor(Datum),
Logger = factor(Logger))
ANOVA_MT <- aov_car(
Temp_schatten_mean ~ Logger + Error(Datum / Logger),
data = dat_MT)
summary(ANOVA_MT)
PostHoc_MT <- emmeans(ANOVA_MT, specs = "Logger")
pairs(PostHoc_MT, adjust = "bonferroni")
