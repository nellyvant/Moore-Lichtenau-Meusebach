scale_color_discrete(
labels = c("L" = "Kleiner Sumpf",
"MN" = "Auf der Pfalz",
"MT" = "Fuchshügel"))+
labs(
title = "tägliche Lichtsumme im Beobachtungszeitraum (Messintervall 10min)",
x = "Datum",
y = "kumulative Lichtinensität (Lux x Zeit)",
color = "Standort"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
#| label: create table of day of min&max mean temperature
#Temperatur
#Minimum & Maximum der Temperaturmittelwerte für die einzelnen Logger
daily_logger_means_min_max <- summary_daily_logger %>%
group_by(Logger_ID) %>%
summarise(
# Sonne
#    Sonne_max_mean = max(Temp_sonne_mean, na.rm = TRUE),
#    Sonne_max_mean_Tag = Datum[which.max(Temp_sonne_mean)],
#    Sonne_min_mean = min(Temp_sonne_mean, na.rm = TRUE),
#    Sonne_min_mean_Tag = Datum[which.min(Temp_sonne_mean)],
# Schatten
Schatten_max_mean = max(Temp_schatten_mean, na.rm = TRUE),
Schatten_max_mean_Tag = Datum[which.max(Temp_schatten_mean)],
Schatten_min_mean = min(Temp_schatten_mean, na.rm = TRUE),
Schatten_min_mean_Tag = Datum[which.min(Temp_schatten_mean)])
#| label: create table of day&time of min&max temperature
daily_logger_extrema <- all_loggers %>%
mutate(Datum = as.Date(DateTime)) %>%
group_by(Standort, Logger,Logger_ID, Datum) %>%
summarise(
## SONNE
Temp_sonne_max =max(Temp_sonne_C, na.rm = TRUE),
Time_sonne_max = DateTime[which.max(replace_na(Temp_sonne_C, -Inf))],
Temp_sonne_min =min(Temp_sonne_C, na.rm = TRUE),
Time_sonne_min =DateTime[which.max(replace_na(Temp_sonne_C, -Inf))],
## SCHATTEN
#Temp_schatten_max =
#      if (all(is.na(Temp_schatten_C))) NA_real_
#      else max(Temp_schatten_C, na.rm = TRUE),
#    Time_schatten_max =
#      if (all(is.na(Temp_schatten_C))) as.POSIXct(NA)
#      else DateTime[which.max(Temp_schatten_C)],
#    Temp_schatten_min =
#      if (all(is.na(Temp_schatten_C))) NA_real_
#      else min(Temp_schatten_C, na.rm = TRUE),
#    Time_schatten_min =
#      if (all(is.na(Temp_schatten_C))) as.POSIXct(NA)
#      else DateTime[which.min(Temp_schatten_C)],
.groups = "drop"
)
#Auswertung
extrema_logger <- daily_logger_extrema %>%
group_by(Standort, Logger,Logger_ID) %>%
summarise(
# Sonne
Sonne_max = max(Temp_sonne_max, na.rm = TRUE),
Sonne_max_Zeit = Time_sonne_max[which.max(Temp_sonne_max)],
Sonne_min = min(Temp_sonne_min, na.rm = TRUE),
Sonne_min_Zeit = Time_sonne_min[which.min(Temp_sonne_min)],
# Schatten
#    Schatten_max = max(Temp_schatten_max, na.rm = TRUE),
#    Schatten_max_Zeit = Time_schatten_max[which.max(Temp_schatten_max)],
#    Schatten_min = min(Temp_schatten_min, na.rm = TRUE),
#    Schatten_min_Zeit = Time_schatten_min[which.min(Temp_schatten_min)]
.groups = "drop" )
summary(extrema_logger)
#| label: temperature ranges all areas
extrema_logger <- extrema_logger %>%
left_join(summary_logger_year %>%
select(Standort, Logger, Logger_ID, Tempschatten_Jahresmittel),
by = c("Standort","Logger","Logger_ID"))
str(extrema_logger)
flaechen_namen <- c(
"L" = "Kleiner Sumpf",
"MN" = "Auf der Pfalz",
"MT" = "Fuchshügel")
ggplot(extrema_logger, aes(x = Logger)) +
geom_linerange(aes(ymin = Sonne_min, ymax = Sonne_max, color = Standort),
size = 1) +
geom_point(aes(y = Tempschatten_Jahresmittel, color = Standort),
size = 3) +
geom_text(aes(y = Sonne_min, label = format(Sonne_min_Zeit, "%d.%m")),
vjust = 1.5,
size = 3,
check_overlap = TRUE) +
geom_text(aes(y = Sonne_max, label = format(Sonne_max_Zeit, "%d.%m")),
vjust = -0.5,
size = 3,
check_overlap = TRUE) +
facet_wrap(~Standort, scales = "free_x", nrow = 1, labeller = labeller(Standort = flaechen_namen))+
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),legend.position = "none") +
labs(
x = "Logger",
y = "Temperatur [°C]",
title = "Temperaturspitzen und Mittelwert pro Logger und Standort"
)
#| label: lineplot Lichtenau Nord-Sued mean&max&min temperature
daily_logger_extrema <- daily_logger_extrema %>%
left_join(summary_daily_logger %>%
select(Standort, Logger, Logger_ID,Datum, Temp_schatten_mean),
by = c("Standort","Logger","Logger_ID","Datum"))
str(daily_logger_extrema)
ggplot(
daily_logger_extrema |>
dplyr::filter(Standort == "L", Logger %in% c("M","N","S")),
aes(x = Datum, color = Logger)
) +
geom_line(aes(y = Temp_schatten_mean, linetype = "Mean")) +
geom_line(aes(y = Temp_sonne_max, linetype = "Maximum")) +
geom_line(aes(y = Temp_sonne_min, linetype = "Minimum")) +
scale_linetype_manual(
values = c(
"Mean" = "solid",
"Maximum" = "dashed",
"Minimum" = "dotted"
)
) +
labs(
title = "Temperaturverlauf in Lichtenau am Nord-Süd-Gradienten",
x = "Datum",
y = "Temperatur (°C)",
color = "Logger",
linetype = ""
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5)
)
