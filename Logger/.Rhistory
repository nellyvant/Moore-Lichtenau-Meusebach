filter(Standort %in% c("L", "MT", "MN"),
Logger %in% c("N","M","S", "W", "O")) %>%
# nur Außen-Sensor verwenden
ggplot(aes(x = Temp_sonne_mean, y = rLF_mean, shape = Logger, color = Logger)) +
geom_point(size = 2, alpha = 0.7) +
labs(
title = "Temperatur vs. Luftfeuchte (Außen-Sensor) pro Standort",
x = "Temperatur (°C)",
y = "Luftfeuchte (%)",
shape = "Logger"
) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5))
