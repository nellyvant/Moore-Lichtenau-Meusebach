#Vergleich Tagesmittelwerte
#MT
dat_MT <- summary_daily_logger %>%
filter(
Standort == "MT",
is.finite(rLF_mean)
) %>%
mutate(
Datum = factor(Datum),
Logger = factor(Logger))
ANOVA_MT <- aov_car(
rLF_mean ~ Logger + Error(Datum / Logger),
data = dat_MT)
summary(ANOVA_MT)
PostHoc_MT <- emmeans(ANOVA_MT, specs = "Logger")
pairs(PostHoc_MT, adjust = "bonferroni")
# 66 Tage wurden wegen fehlender Werte entfernt
# contrast estimate    SE df t.ratio p.value
# M - N       2.002 0.201 79   9.953 <0.0001
# M - O       2.638 0.164 79  16.052 <0.0001
# M - S       0.876 0.113 79   7.781 <0.0001
# M - W       7.931 0.234 79  33.907 <0.0001
# N - O       0.636 0.218 79   2.916  0.0461
# N - S      -1.125 0.208 79  -5.405 <0.0001
# N - W       5.930 0.281 79  21.121 <0.0001
# O - S      -1.761 0.210 79  -8.378 <0.0001
# O - W       5.294 0.347 79  15.240 <0.0001
# S - W       7.055 0.218 79  32.406 <0.0001
