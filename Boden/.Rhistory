fill = hum_factor
),
color = "black"
) +
scale_fill_manual(
values = hum_colors,
name = "Humifizierung",
labels = function(x) paste0("H", x),,
na.translate = FALSE
)+
scale_x_continuous(
breaks = seq_along(levels(plot_data$Punkt)),
labels = stringr::str_wrap(
levels(plot_data$Punkt),
width = 12
)
) +
labs(
x = "Bohrpunkt",
y = "Tiefe [cm]"
) +
theme_bw()
ggsave(Hum_MT, "hum_barplot_MT.png")
ggsave("hum_barplot_MT.png",Hum_MT)
ggsave("hum_barplot_MT.png",Hum_MT,width = 20, height = 20, units = "cm")
