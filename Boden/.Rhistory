} else {
geom
}
}))
shep_reordered <- st_sf(lapply(st_geometry(shep), function(geom) {
if (inherits(geom, "POLYGON") || inherits(geom, "MULTIPOLYGON")) {
poly <- st_polygonize(geom)
st_make_valid(poly[[1]])
} else {
geom
}
}))
# Funktion zum Umkehren der Koordinatenpunkte in jedem Polygon
reverse_coordinates <- function(geom) {
if (inherits(geom, "POLYGON") || inherits(geom, "MULTIPOLYGON")) {
geom_reversed <- st_polygon(list(geom[[1]][c(seq_along(geom[[1]]), 1)]))
} else {
geom_reversed <- geom
}
return(geom_reversed)
}
# Umkehren der Koordinatenpunkte in jedem Polygon
shep_reordered <- st_sf(lapply(st_geometry(shep), reverse_coordinates))
return(geom_reversed)
# Funktion zum Umkehren der Koordinatenpunkte in jedem Polygon
reverse_coordinates <- function(geom) {
if (inherits(geom, "POLYGON") || inherits(geom, "MULTIPOLYGON")) {
geom_reversed <- st_polygon(list(geom[[1]][c(seq_along(geom[[1]]), 1)]))
} else {
geom_reversed <- geom
}
return(geom_reversed)
}
# Umkehren der Koordinatenpunkte in jedem Polygon
shep_reordered <- st_sf(lapply(st_geometry(shep), reverse_coordinates))
# Funktion zum Umkehren der Koordinatenpunkte in jedem Polygon
reverse_coordinates <- function(coords) {
coords[c(seq_len(nrow(coords)), 1), ]  # Koordinatenpunkte umkehren und das erste Element an das Ende setzen
}
# Umkehren der Koordinatenpunkte in jedem Polygon
