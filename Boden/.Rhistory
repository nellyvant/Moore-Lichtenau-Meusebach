# make table with data
precip <- c(600, 520, 680, 525, 490)
N_cont <- c(0.32, 0.55, 0.21, 0.77, 0.12)
Data_orig <- rbind(precip, N_cont)
colnames(Data_orig) <- paste("Plot", 1:5, sep = "")
Data_orig
Data_orig.mean <- rowMeans(Data_orig)
Data_orig.sd <- apply(Data_orig, MARGIN = 1, sd)
Data_orig.centered <- Data_orig - Data_orig.mean
Data_orig.standardized <- Data_orig.centered / Data_orig.sd
Data_orig.standardized
# Exercise: calculate the means and sd for the rows of
# Data_orig.standardized
rowMeans(Data_orig.standardized)
round(rowMeans(Data_orig.standardized), 2)
apply(Data_orig.standardized, MARGIN = 1, sd)
