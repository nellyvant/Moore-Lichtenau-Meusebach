.groups = "drop"
)
View(hum_summary)
#hier werden Mitelwerte berechnet, obwohl die Skala eigentlich ordinal ist! also mit Vorsicht genießen! oder vlt lieber auf max oder min verlassen
hum_summary <- hum %>%
filter(!is.na(hum_num)) %>%
group_by(Punkt, site, transekt) %>%
summarise(
