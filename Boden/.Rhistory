dummy_model <- lm(outcome ~ predictor1 + predictor2, data = dummy_data)
# Ergebnisse mit capture.output speichern
model_summary <- capture.output(summary(dummy_model))
# Ergebnisse in der Konsole anzeigen
print(model_summary)
# Ergebnisse in eine Datei speichern
writeLines(model_summary, "model_summary.txt")
library(broom)
library(dplyr)
library(kableExtra)
install.packages("kableExtra")
library(kableExtra)
# Dummy-Daten erstellen
set.seed(123)
dummy_data <- data.frame(
outcome = rnorm(100, mean = 50, sd = 10),
predictor1 = rnorm(100, mean = 20, sd = 5),
predictor2 = rnorm(100, mean = 10, sd = 3)
)
# Lineares Modell erstellen
dummy_model <- lm(outcome ~ predictor1 + predictor2, data = dummy_data)
# Zusammenfassung der Modellkoeffizienten mit broom::tidy
tidy_model <- tidy(dummy_model)
# Modellstatistiken wie R-squared mit broom::glance
model_stats <- glance(dummy_model)
# Signifikante p-Werte hervorheben
tidy_model <- tidy_model %>%
mutate(significance = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
))
# Tabelle erstellen mit kableExtra
tidy_model %>%
select(term, estimate, std.error, statistic, p.value, significance) %>%
kable("html", caption = paste0("Modellzusammenfassung (R² = ",
round(model_stats$r.squared, 3), ")")) %>%
kable_styling(full_width = FALSE) %>%
add_header_above(c(" " = 1, "Koeffizienten" = 3, " " = 2)) %>%
column_spec(5, bold = TRUE, color = "red", background = "lightyellow")
model_stats
summary(dummy_model)
